{"ast":null,"code":"import { Check } from 'lucide-vue-next';\nexport default {\n  name: 'DesignCard',\n  components: {\n    Check\n  },\n  props: {\n    design: {\n      type: Object,\n      required: true\n    },\n    selected: {\n      type: Boolean,\n      default: false\n    },\n    compact: {\n      type: Boolean,\n      default: false\n    }\n  },\n  emits: ['select']\n};","map":{"version":3,"names":["Check","name","components","props","design","type","Object","required","selected","Boolean","default","compact","emits"],"sources":["C:\\Users\\jayde\\Desktop\\frameVue\\src\\components\\customer\\DesignCard.vue"],"sourcesContent":["<template>\n  <div\n    :class=\"[\n      'group relative rounded-2xl overflow-hidden transition-all duration-200 flex flex-col bg-white cursor-pointer',\n      selected\n        ? 'ring-2 ring-gold-600 border-gold-600 shadow-elevated'\n        : 'border border-cream-200 shadow-soft hover:border-gold-400 hover:shadow-md'\n    ]\"\n    @click=\"$emit('select', design)\"\n  >\n    <!-- Preview Thumbnail -->\n    <div class=\"relative aspect-4/3 overflow-hidden bg-cream-100\">\n      <img\n        :src=\"design.image\"\n        :alt=\"design.name\"\n        class=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-500\"\n        loading=\"lazy\"\n      />\n      <!-- Category Pill -->\n      <span class=\"absolute top-2.5 left-2.5 px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-white/95 text-charcoal-900 backdrop-blur-xs shadow-2xs\">\n        {{ design.category }}\n      </span>\n\n      <!-- Selected Check Indicator -->\n      <div\n        v-if=\"selected\"\n        class=\"absolute top-2.5 right-2.5 w-7 h-7 rounded-full bg-gold-600 text-white flex items-center justify-center shadow-md\"\n      >\n        <Check class=\"w-4 h-4 stroke-[2.5]\" />\n      </div>\n    </div>\n\n    <!-- Card Body -->\n    <div class=\"p-4 flex-1 flex flex-col justify-between gap-3\">\n      <div>\n        <div class=\"flex items-center justify-between gap-2\">\n          <h4 class=\"text-sm font-serif font-semibold text-charcoal-900 line-clamp-1\">\n            {{ design.name }}\n          </h4>\n          <span\n            class=\"text-xs font-serif\"\n            :style=\"{ color: design.accentColor || '#B07B38' }\"\n          >\n            {{ design.badgeText || '✦' }}\n          </span>\n        </div>\n        <p v-if=\"!compact\" class=\"text-xs text-charcoal-800/70 mt-1 line-clamp-2\">\n          {{ design.description }}\n        </p>\n      </div>\n\n      <button\n        type=\"button\"\n        :class=\"[\n          'w-full py-2 px-3 rounded-xl text-xs font-semibold transition-colors flex items-center justify-center gap-1.5',\n          selected\n            ? 'bg-gold-600 text-white'\n            : 'bg-cream-100 text-charcoal-900 hover:bg-charcoal-900 hover:text-white'\n        ]\"\n        @click.stop=\"$emit('select', design)\"\n      >\n        <Check v-if=\"selected\" class=\"w-3.5 h-3.5\" />\n        <span>{{ selected ? 'Selected' : 'Select' }}</span>\n      </button>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { Check } from 'lucide-vue-next'\n\nexport default {\n  name: 'DesignCard',\n  components: { Check },\n  props: {\n    design: {\n      type: Object,\n      required: true\n    },\n    selected: {\n      type: Boolean,\n      default: false\n    },\n    compact: {\n      type: Boolean,\n      default: false\n    }\n  },\n  emits: ['select']\n}\n</script>\n"],"mappings":"AAqEA,SAASA,KAAI,QAAS,iBAAgB;AAEtC,eAAe;EACbC,IAAI,EAAE,YAAY;EAClBC,UAAU,EAAE;IAAEF;EAAM,CAAC;EACrBG,KAAK,EAAE;IACLC,MAAM,EAAE;MACNC,IAAI,EAAEC,MAAM;MACZC,QAAQ,EAAE;IACZ,CAAC;IACDC,QAAQ,EAAE;MACRH,IAAI,EAAEI,OAAO;MACbC,OAAO,EAAE;IACX,CAAC;IACDC,OAAO,EAAE;MACPN,IAAI,EAAEI,OAAO;MACbC,OAAO,EAAE;IACX;EACF,CAAC;EACDE,KAAK,EAAE,CAAC,QAAQ;AAClB","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}