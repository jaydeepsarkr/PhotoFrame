{"ast":null,"code":"import \"core-js/modules/es.array.includes.js\";\nimport { mapGetters, mapActions } from 'vuex';\nimport { Menu, Plus, Store, Sun, Moon } from 'lucide-vue-next';\nexport default {\n  name: 'AdminHeader',\n  components: {\n    Menu,\n    Plus,\n    Store,\n    Sun,\n    Moon\n  },\n  emits: ['toggle-sidebar'],\n  computed: {\n    ...mapGetters(['darkMode']),\n    pageTitle() {\n      const path = this.$route.path;\n      if (path === '/admin') return 'Admin Dashboard';\n      if (path.includes('/admin/frames/add') || path.includes('/admin/frames/edit')) return 'Frame Editor';\n      if (path.startsWith('/admin/frames')) return 'Frame Catalog Management';\n      if (path.includes('/admin/designs/add') || path.includes('/admin/designs/edit')) return 'Design Template Editor';\n      if (path.startsWith('/admin/designs')) return 'Design Library Management';\n      if (path.startsWith('/admin/orders/')) return 'Order Details & Fulfillment';\n      if (path.startsWith('/admin/orders')) return 'Customer Orders';\n      return 'Admin Studio';\n    }\n  },\n  methods: {\n    ...mapActions(['toggleDarkMode'])\n  }\n};","map":{"version":3,"names":["mapGetters","mapActions","Menu","Plus","Store","Sun","Moon","name","components","emits","computed","pageTitle","path","$route","includes","startsWith","methods"],"sources":["C:\\Users\\jayde\\Desktop\\frameVue\\src\\components\\admin\\AdminHeader.vue"],"sourcesContent":["<template>\n  <header class=\"sticky top-0 z-30 h-20 bg-white/95 backdrop-blur-md border-b border-cream-200 px-4 sm:px-6 lg:px-8 flex items-center justify-between gap-4\">\n    <div class=\"flex items-center gap-3\">\n      <button\n        type=\"button\"\n        class=\"p-2.5 rounded-xl border border-cream-300 text-charcoal-900 hover:bg-cream-100 lg:hidden\"\n        aria-label=\"Open admin sidebar\"\n        @click=\"$emit('toggle-sidebar')\"\n      >\n        <Menu class=\"w-5 h-5\" />\n      </button>\n\n      <div>\n        <h1 class=\"text-lg sm:text-xl font-serif font-bold text-charcoal-900\">\n          {{ pageTitle }}\n        </h1>\n        <p class=\"text-xs text-charcoal-800/60 hidden sm:block\">\n          Manage bespoke photo frames, design templates, and customer orders\n        </p>\n      </div>\n    </div>\n\n    <div class=\"flex items-center gap-2.5\">\n      <!-- Dark Mode Toggle -->\n      <button\n        type=\"button\"\n        class=\"p-2.5 rounded-xl bg-cream-100 hover:bg-cream-200 text-charcoal-900 border border-cream-300 transition-colors\"\n        :title=\"darkMode ? 'Switch to Light Mode' : 'Switch to Dark Mode'\"\n        aria-label=\"Toggle dark mode\"\n        @click=\"toggleDarkMode\"\n      >\n        <Sun v-if=\"darkMode\" class=\"w-4 h-4 text-gold-400\" />\n        <Moon v-else class=\"w-4 h-4 text-charcoal-800\" />\n      </button>\n\n      <router-link\n        to=\"/admin/frames/add\"\n        class=\"hidden sm:inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-cream-100 hover:bg-cream-200 text-charcoal-900 border border-cream-300 text-xs font-semibold transition-colors\"\n      >\n        <Plus class=\"w-3.5 h-3.5 text-gold-600\" />\n        <span>New Frame</span>\n      </router-link>\n\n      <router-link\n        to=\"/admin/designs/add\"\n        class=\"hidden sm:inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-cream-100 hover:bg-cream-200 text-charcoal-900 border border-cream-300 text-xs font-semibold transition-colors\"\n      >\n        <Plus class=\"w-3.5 h-3.5 text-gold-600\" />\n        <span>New Design</span>\n      </router-link>\n\n      <router-link\n        to=\"/\"\n        class=\"hidden md:inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-cream-100 hover:bg-cream-200 text-charcoal-900 border border-cream-300 text-xs font-semibold transition-colors\"\n      >\n        <Store class=\"w-3.5 h-3.5\" />\n        <span>Storefront</span>\n      </router-link>\n\n      <!-- Admin Profile & Logout -->\n      <div class=\"flex items-center gap-2 pl-2 border-l border-cream-300 dark:border-charcoal-700\">\n        <div class=\"hidden lg:flex flex-col text-right\">\n          <span class=\"text-xs font-semibold text-charcoal-900 dark:text-cream-100 leading-tight\">\n            {{ adminName || 'Admin' }}\n          </span>\n          <span class=\"text-[10px] text-charcoal-500 dark:text-cream-400 font-mono\">\n            {{ adminEmail || 'admin@ateliercadre.in' }}\n          </span>\n        </div>\n\n        <button\n          type=\"button\"\n          class=\"inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-red-50 hover:bg-red-100 dark:bg-red-950/40 dark:hover:bg-red-900/60 text-red-700 dark:text-red-300 border border-red-200 dark:border-red-900/50 text-xs font-semibold transition-colors\"\n          title=\"Sign out of Admin Console\"\n          @click=\"handleLogout\"\n        >\n          <LogOut class=\"w-3.5 h-3.5\" />\n          <span class=\"hidden sm:inline\">Logout</span>\n        </button>\n      </div>\n    </div>\n  </header>\n</template>\n\n<script>\nimport { mapGetters, mapActions } from 'vuex'\nimport { Menu, Plus, Store, Sun, Moon } from 'lucide-vue-next'\n\nexport default {\n  name: 'AdminHeader',\n  components: {\n    Menu,\n    Plus,\n    Store,\n    Sun,\n    Moon\n  },\n  emits: ['toggle-sidebar'],\n  computed: {\n    ...mapGetters(['darkMode']),\n    pageTitle() {\n      const path = this.$route.path\n      if (path === '/admin') return 'Admin Dashboard'\n      if (path.includes('/admin/frames/add') || path.includes('/admin/frames/edit')) return 'Frame Editor'\n      if (path.startsWith('/admin/frames')) return 'Frame Catalog Management'\n      if (path.includes('/admin/designs/add') || path.includes('/admin/designs/edit')) return 'Design Template Editor'\n      if (path.startsWith('/admin/designs')) return 'Design Library Management'\n      if (path.startsWith('/admin/orders/')) return 'Order Details & Fulfillment'\n      if (path.startsWith('/admin/orders')) return 'Customer Orders'\n      return 'Admin Studio'\n    }\n  },\n  methods: {\n    ...mapActions(['toggleDarkMode'])\n  }\n}\n</script>\n"],"mappings":";AAqFA,SAASA,UAAU,EAAEC,UAAS,QAAS,MAAK;AAC5C,SAASC,IAAI,EAAEC,IAAI,EAAEC,KAAK,EAAEC,GAAG,EAAEC,IAAG,QAAS,iBAAgB;AAE7D,eAAe;EACbC,IAAI,EAAE,aAAa;EACnBC,UAAU,EAAE;IACVN,IAAI;IACJC,IAAI;IACJC,KAAK;IACLC,GAAG;IACHC;EACF,CAAC;EACDG,KAAK,EAAE,CAAC,gBAAgB,CAAC;EACzBC,QAAQ,EAAE;IACR,GAAGV,UAAU,CAAC,CAAC,UAAU,CAAC,CAAC;IAC3BW,SAASA,CAAA,EAAG;MACV,MAAMC,IAAG,GAAI,IAAI,CAACC,MAAM,CAACD,IAAG;MAC5B,IAAIA,IAAG,KAAM,QAAQ,EAAE,OAAO,iBAAgB;MAC9C,IAAIA,IAAI,CAACE,QAAQ,CAAC,mBAAmB,KAAKF,IAAI,CAACE,QAAQ,CAAC,oBAAoB,CAAC,EAAE,OAAO,cAAa;MACnG,IAAIF,IAAI,CAACG,UAAU,CAAC,eAAe,CAAC,EAAE,OAAO,0BAAyB;MACtE,IAAIH,IAAI,CAACE,QAAQ,CAAC,oBAAoB,KAAKF,IAAI,CAACE,QAAQ,CAAC,qBAAqB,CAAC,EAAE,OAAO,wBAAuB;MAC/G,IAAIF,IAAI,CAACG,UAAU,CAAC,gBAAgB,CAAC,EAAE,OAAO,2BAA0B;MACxE,IAAIH,IAAI,CAACG,UAAU,CAAC,gBAAgB,CAAC,EAAE,OAAO,6BAA4B;MAC1E,IAAIH,IAAI,CAACG,UAAU,CAAC,eAAe,CAAC,EAAE,OAAO,iBAAgB;MAC7D,OAAO,cAAa;IACtB;EACF,CAAC;EACDC,OAAO,EAAE;IACP,GAAGf,UAAU,CAAC,CAAC,gBAAgB,CAAC;EAClC;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}