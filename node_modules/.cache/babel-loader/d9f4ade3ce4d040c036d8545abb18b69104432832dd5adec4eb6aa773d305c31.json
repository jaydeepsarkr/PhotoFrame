   { key: 'Customize', label: 'Customize' },\n        { key: 'Details', label: 'Details' },\n        { key: 'Review', label: 'Review' }\n      ]\n    }\n  },\n  emits: ['step-click'],\n  computed: {\n    ...mapGetters(['enableDesignSection']),\n    effectiveSteps() {\n      const baseSteps = this.steps || []\n      if (!this.enableDesignSection) {\n        return baseSteps.filter(s => s.key.toLowerCase() !== 'design')\n      }\n      return baseSteps\n    },\n    currentIndex() {\n      const found = this.effectiveSteps.findIndex(\n        s => s.key.toLowerCase() === String(this.currentStep).toLowerCase()\n      )\n      return found === -1 ? 0 : found\n    }\n  }\n}\n</script>\n"],"mappings":";;AAgDA,SAASA,UAAS,QAAS,MAAK;AAChC,SAASC,KAAK,EAAEC,YAAW,QAAS,iBAAgB;AAEpD,eAAe;EACbC,IAAI,EAAE,iBAAiB;EACvBC,UAAU,EAAE;IACVH,KAAK;IACLC;EACF,CAAC;EACDG,KAAK,EAAE;IACLC,WAAW,EAAE;MACXC,IAAI,EAAEC,MAAM;MACZC,OAAO,EAAE;IACX,CAAC;IACDC,KAAK,EAAE;MACLH,IAAI,EAAEI,KAAK;MACXF,OAAO,EAAEA,CAAA,KAAM,CACb;QAAEG,GAAG,EAAE,OAAO;QAAEC,KAAK,EAAE;MAAQ,CAAC,EAChC;QAAED,GAAG,EAAE,QAAQ;QAAEC,KAAK,EAAE;MAAS,CAAC,EAClC;QAAED,GAAG,EAAE,WAAW;QAAEC,KAAK,EAAE;MAAY,CAAC,EACxC;QAAED,GAAG,EAAE,SAAS;QAAEC,KAAK,EAAE;MAAU,CAAC,EACpC;QAAED,GAAG,EAAE,QAAQ;QAAEC,KAAK,EAAE;MAAS;IAErC;EACF,CAAC;EACDC,KAAK,EAAE,CAAC,YAAY,CAAC;EACrBC,QAAQ,EAAE;IACR,GAAGf,UAAU,CAAC,CAAC,qBAAqB,CAAC,CAAC;IACtCgB,cAAcA,CAAA,EAAG;MACf,MAAMC,SAAQ,GAAI,IAAI,CAACP,KAAI,IAAK,EAAC;MACjC,IAAI,CAAC,IAAI,CAACQ,mBAAmB,EAAE;QAC7B,OAAOD,SAAS,CAACE,MAAM,CAACC,CAAA,IAAKA,CAAC,CAACR,GAAG,CAACS,WAAW,CAAC,MAAM,QAAQ;MAC/D;MACA,OAAOJ,SAAQ;IACjB,CAAC;IACDK,YAAYA,CAAA,EAAG;MACb,MAAMC,KAAI,GAAI,IAAI,CAACP,cAAc,CAACQ,SAAS,CACzCJ,CAAA,IAAKA,CAAC,CAACR,GAAG,CAACS,WAAW,CAAC,MAAMb,MAAM,CAAC,IAAI,CAACF,WAAW,CAAC,CAACe,WAAW,CAAC,CACpE;MACA,OAAOE,KAAI,KAAM,CAAC,IAAI,IAAIA,KAAI;IAChC;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}