{"ast":null,"code":"import \"core-js/modules/es.array.includes.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport { mapGetters } from 'vuex';\nimport { Plus, Eye, Pencil, Trash2 } from 'lucide-vue-next';\nimport StatusBadge from '@/components/common/StatusBadge.vue';\nimport Modal from '@/components/common/Modal.vue';\nimport ConfirmModal from '@/components/common/ConfirmModal.vue';\nimport { formatCurrency, formatSizeLabel } from '@/utils/formatters';\nexport default {\n  name: 'AdminFramesView',\n  components: {\n    Plus,\n    Eye,\n    Pencil,\n    Trash2,\n    StatusBadge,\n    Modal,\n    ConfirmModal\n  },\n  data() {\n    return {\n      searchQuery: '',\n      viewModalOpen: false,\n      viewingFrame: null,\n      confirmDeleteOpen: false,\n      frameToDelete: null\n    };\n  },\n  computed: {\n    ...mapGetters('frames', ['allFrames']),\n    filteredFrames() {\n      const q = this.searchQuery.toLowerCase();\n      if (!q) return this.allFrames;\n      return this.allFrames.filter(f => f.name.toLowerCase().includes(q) || String(f.material || '').toLowerCase().includes(q));\n    }\n  },\n  methods: {\n    formatCurrency,\n    formatSizeLabel,\n    openViewModal(frame) {\n      this.viewingFrame = frame;\n      this.viewModalOpen = true;\n    },\n    promptDelete(frame) {\n      this.frameToDelete = frame;\n      this.confirmDeleteOpen = true;\n    },\n    async confirmDelete() {\n      if (this.frameToDelete) {\n        await this.$store.dispatch('frames/deleteFrame', this.frameToDelete.id);\n        this.frameToDelete = null;\n      }\n    }\n  }\n};","map":{"version":3,"names":["mapGetters","Plus","Eye","Pencil","Trash2","StatusBadge","Modal","ConfirmModal","formatCurrency","formatSizeLabel","name","components","data","searchQuery","viewModalOpen","viewingFrame","confirmDeleteOpen","frameToDelete","computed","filteredFrames","q","toLowerCase","allFrames","filter","f","includes","String","material","methods","openViewModal","frame","promptDelete","confirmDelete","$store","dispatch","id"],"sources":["C:\\Users\\jayde\\Desktop\\frameVue\\src\\views\\admin\\Frames.vue"],"sourcesContent":["<template>\n  <div class=\"space-y-6\">\n    <!-- Top Bar -->\n    <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white rounded-2xl border border-cream-200 p-5 shadow-soft\">\n      <div>\n        <h2 class=\"text-xl font-serif font-bold text-charcoal-900\">\n          All Photo Frames ({{ filteredFrames.length }})\n        </h2>\n        <p class=\"text-xs text-charcoal-800/65\">\n          Manage frame mouldings, materials, sizes, and pricing\n        </p>\n      </div>\n\n      <div class=\"flex flex-wrap items-center gap-3\">\n        <input\n          v-model.trim=\"searchQuery\"\n          type=\"text\"\n          placeholder=\"Search frame name or material...\"\n          class=\"px-3.5 py-2 rounded-xl bg-cream-50 border border-cream-300 text-xs text-charcoal-900 focus:outline-hidden focus:border-gold-600\"\n        />\n        <router-link\n          to=\"/admin/frames/add\"\n          class=\"inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-charcoal-900 hover:bg-gold-600 text-white text-xs font-semibold transition-colors shadow-xs\"\n        >\n          <Plus class=\"w-4 h-4\" />\n          <span>Add Frame</span>\n        </router-link>\n      </div>\n    </div>\n\n    <!-- Frames Table -->\n    <div class=\"bg-white rounded-2xl border border-cream-200 shadow-soft overflow-hidden\">\n      <div class=\"overflow-x-auto\">\n        <table class=\"w-full text-left border-collapse\">\n          <thead>\n            <tr class=\"border-b border-cream-200 bg-cream-50/80 text-[11px] font-semibold uppercase tracking-wider text-charcoal-800/70\">\n              <th class=\"py-3.5 px-4\">Image</th>\n              <th class=\"py-3.5 px-4\">Name</th>\n              <th class=\"py-3.5 px-4\">Material</th>\n              <th class=\"py-3.5 px-4\">Sizes</th>\n              <th class=\"py-3.5 px-4\">Price</th>\n              <th class=\"py-3.5 px-4\">Status</th>\n              <th class=\"py-3.5 px-4 text-right\">Actions</th>\n            </tr>\n          </thead>\n          <tbody class=\"divide-y divide-cream-200 text-sm\">\n            <tr\n              v-for=\"frame in filteredFrames\"\n              :key=\"frame.id\"\n              class=\"hover:bg-cream-50/60 transition-colors\"\n            >\n              <td class=\"py-3.5 px-4\">\n                <img\n                  :src=\"frame.image\"\n                  :alt=\"frame.name\"\n                  class=\"w-14 h-14 rounded-xl object-cover border border-cream-300\"\n                />\n              </td>\n              <td class=\"py-3.5 px-4\">\n                <div class=\"font-serif font-semibold text-charcoal-900\">\n                  {{ frame.name }}\n                </div>\n                <div class=\"text-xs text-charcoal-800/60 line-clamp-1 max-w-xs\">\n                  {{ frame.description }}\n                </div>\n              </td>\n              <td class=\"py-3.5 px-4\">\n                <span class=\"px-2.5 py-1 rounded-full text-xs font-medium bg-cream-100 text-charcoal-800 border border-cream-300\">\n                  {{ frame.material }}\n                </span>\n              </td>\n              <td class=\"py-3.5 px-4\">\n                <div class=\"flex flex-wrap gap-1 max-w-xs\">\n                  <span\n                    v-for=\"size in frame.sizes\"\n                    :key=\"size\"\n                    class=\"px-2 py-0.5 rounded-md text-[11px] font-medium bg-cream-50 border border-cream-300 text-charcoal-800\"\n                  >\n                    {{ formatSizeLabel(size) }}\n                  </span>\n                </div>\n              </td>\n              <td class=\"py-3.5 px-4 whitespace-nowrap\">\n                <span class=\"font-bold text-charcoal-900\">\n                  {{ formatCurrency(frame.discountPrice || frame.price) }}\n                </span>\n                <span\n                  v-if=\"frame.discountPrice && frame.discountPrice < frame.price\"\n                  class=\"block text-[11px] text-charcoal-800/45 line-through\"\n                >\n                  {{ formatCurrency(frame.price) }}\n                </span>\n              </td>\n              <td class=\"py-3.5 px-4 whitespace-nowrap\">\n                <StatusBadge :status=\"frame.status || 'active'\" />\n              </td>\n              <td class=\"py-3.5 px-4 text-right whitespace-nowrap\">\n                <div class=\"inline-flex items-center gap-1.5\">\n                  <button\n                    type=\"button\"\n                    class=\"p-2 rounded-xl bg-cream-100 hover:bg-cream-200 text-charcoal-800 transition-colors\"\n                    title=\"View Frame\"\n                    @click=\"openViewModal(frame)\"\n                  >\n                    <Eye class=\"w-4 h-4\" />\n                  </button>\n                  <router-link\n                    :to=\"`/admin/frames/add?edit=${frame.id}`\"\n                    class=\"p-2 rounded-xl bg-cream-100 hover:bg-gold-100 text-charcoal-800 hover:text-gold-800 transition-colors\"\n                    title=\"Edit Frame\"\n                  >\n                    <Pencil class=\"w-4 h-4\" />\n                  </router-link>\n                  <button\n                    type=\"button\"\n                    class=\"p-2 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-600 transition-colors\"\n                    title=\"Delete Frame\"\n                    @click=\"promptDelete(frame)\"\n                  >\n                    <Trash2 class=\"w-4 h-4\" />\n                  </button>\n                </div>\n              </td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n    </div>\n\n    <!-- Quick View Frame Modal -->\n    <Modal\n      v-model=\"viewModalOpen\"\n      :title=\"viewingFrame?.name || 'Frame Details'\"\n      max-width=\"md\"\n    >\n      <div v-if=\"viewingFrame\" class=\"space-y-4\">\n        <img\n          :src=\"viewingFrame.image\"\n          :alt=\"viewingFrame.name\"\n          class=\"w-full h-56 object-cover rounded-2xl border border-cream-200\"\n        />\n        <p class=\"text-sm text-charcoal-800/80 leading-relaxed\">\n          {{ viewingFrame.description }}\n        </p>\n        <div class=\"grid grid-cols-2 gap-3 text-xs bg-cream-50 p-4 rounded-xl border border-cream-200\">\n          <div>\n            <span class=\"text-charcoal-800/60 block\">Material</span>\n            <strong class=\"text-charcoal-900\">{{ viewingFrame.material }}</strong>\n          </div>\n          <div>\n            <span class=\"text-charcoal-800/60 block\">Price</span>\n            <strong class=\"text-charcoal-900\">{{ formatCurrency(viewingFrame.discountPrice || viewingFrame.price) }}</strong>\n          </div>\n          <div class=\"col-span-2\">\n            <span class=\"text-charcoal-800/60 block mb-1\">Available Sizes</span>\n            <div class=\"flex flex-wrap gap-1.5\">\n              <span\n                v-for=\"s in viewingFrame.sizes\"\n                :key=\"s\"\n                class=\"px-2 py-0.5 rounded-md bg-white border border-cream-300 font-semibold\"\n              >\n                {{ formatSizeLabel(s) }}\n              </span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </Modal>\n\n    <!-- Confirm Delete Modal -->\n    <ConfirmModal\n      v-model=\"confirmDeleteOpen\"\n      title=\"Delete Frame\"\n      :message=\"`Are you sure you want to delete '${frameToDelete?.name}' from the catalog?`\"\n      confirm-text=\"Delete Frame\"\n      @confirm=\"confirmDelete\"\n    />\n  </div>\n</template>\n\n<script>\nimport { mapGetters } from 'vuex'\nimport { Plus, Eye, Pencil, Trash2 } from 'lucide-vue-next'\nimport StatusBadge from '@/components/common/StatusBadge.vue'\nimport Modal from '@/components/common/Modal.vue'\nimport ConfirmModal from '@/components/common/ConfirmModal.vue'\nimport { formatCurrency, formatSizeLabel } from '@/utils/formatters'\n\nexport default {\n  name: 'AdminFramesView',\n  components: {\n    Plus,\n    Eye,\n    Pencil,\n    Trash2,\n    StatusBadge,\n    Modal,\n    ConfirmModal\n  },\n  data() {\n    return {\n      searchQuery: '',\n      viewModalOpen: false,\n      viewingFrame: null,\n      confirmDeleteOpen: false,\n      frameToDelete: null\n    }\n  },\n  computed: {\n    ...mapGetters('frames', ['allFrames']),\n    filteredFrames() {\n      const q = this.searchQuery.toLowerCase()\n      if (!q) return this.allFrames\n      return this.allFrames.filter(\n        f =>\n          f.name.toLowerCase().includes(q) ||\n          String(f.material || '').toLowerCase().includes(q)\n      )\n    }\n  },\n  methods: {\n    formatCurrency,\n    formatSizeLabel,\n    openViewModal(frame) {\n      this.viewingFrame = frame\n      this.viewModalOpen = true\n    },\n    promptDelete(frame) {\n      this.frameToDelete = frame\n      this.confirmDeleteOpen = true\n    },\n    async confirmDelete() {\n      if (this.frameToDelete) {\n        await this.$store.dispatch('frames/deleteFrame', this.frameToDelete.id)\n        this.frameToDelete = null\n      }\n    }\n  }\n}\n</script>\n"],"mappings":";;;AAqLA,SAASA,UAAS,QAAS,MAAK;AAChC,SAASC,IAAI,EAAEC,GAAG,EAAEC,MAAM,EAAEC,MAAK,QAAS,iBAAgB;AAC1D,OAAOC,WAAU,MAAO,qCAAoC;AAC5D,OAAOC,KAAI,MAAO,+BAA8B;AAChD,OAAOC,YAAW,MAAO,sCAAqC;AAC9D,SAASC,cAAc,EAAEC,eAAc,QAAS,oBAAmB;AAEnE,eAAe;EACbC,IAAI,EAAE,iBAAiB;EACvBC,UAAU,EAAE;IACVV,IAAI;IACJC,GAAG;IACHC,MAAM;IACNC,MAAM;IACNC,WAAW;IACXC,KAAK;IACLC;EACF,CAAC;EACDK,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,WAAW,EAAE,EAAE;MACfC,aAAa,EAAE,KAAK;MACpBC,YAAY,EAAE,IAAI;MAClBC,iBAAiB,EAAE,KAAK;MACxBC,aAAa,EAAE;IACjB;EACF,CAAC;EACDC,QAAQ,EAAE;IACR,GAAGlB,UAAU,CAAC,QAAQ,EAAE,CAAC,WAAW,CAAC,CAAC;IACtCmB,cAAcA,CAAA,EAAG;MACf,MAAMC,CAAA,GAAI,IAAI,CAACP,WAAW,CAACQ,WAAW,CAAC;MACvC,IAAI,CAACD,CAAC,EAAE,OAAO,IAAI,CAACE,SAAQ;MAC5B,OAAO,IAAI,CAACA,SAAS,CAACC,MAAM,CAC1BC,CAAA,IACEA,CAAC,CAACd,IAAI,CAACW,WAAW,CAAC,CAAC,CAACI,QAAQ,CAACL,CAAC,KAC/BM,MAAM,CAACF,CAAC,CAACG,QAAO,IAAK,EAAE,CAAC,CAACN,WAAW,CAAC,CAAC,CAACI,QAAQ,CAACL,CAAC,CACrD;IACF;EACF,CAAC;EACDQ,OAAO,EAAE;IACPpB,cAAc;IACdC,eAAe;IACfoB,aAAaA,CAACC,KAAK,EAAE;MACnB,IAAI,CAACf,YAAW,GAAIe,KAAI;MACxB,IAAI,CAAChB,aAAY,GAAI,IAAG;IAC1B,CAAC;IACDiB,YAAYA,CAACD,KAAK,EAAE;MAClB,IAAI,CAACb,aAAY,GAAIa,KAAI;MACzB,IAAI,CAACd,iBAAgB,GAAI,IAAG;IAC9B,CAAC;IACD,MAAMgB,aAAaA,CAAA,EAAG;MACpB,IAAI,IAAI,CAACf,aAAa,EAAE;QACtB,MAAM,IAAI,CAACgB,MAAM,CAACC,QAAQ,CAAC,oBAAoB,EAAE,IAAI,CAACjB,aAAa,CAACkB,EAAE;QACtE,IAAI,CAAClB,aAAY,GAAI,IAAG;MAC1B;IACF;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}