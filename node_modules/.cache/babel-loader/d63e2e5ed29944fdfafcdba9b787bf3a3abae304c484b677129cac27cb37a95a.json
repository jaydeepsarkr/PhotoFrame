{"ast":null,"code":"import { X } from 'lucide-vue-next';\nexport default {\n  name: 'ModalDialog',\n  components: {\n    X\n  },\n  props: {\n    modelValue: {\n      type: Boolean,\n      default: false\n    },\n    title: {\n      type: String,\n      default: 'Details'\n    },\n    maxWidth: {\n      type: String,\n      default: 'lg'\n    }\n  },\n  emits: ['update:modelValue', 'close'],\n  computed: {\n    maxWidthClass() {\n      const map = {\n        sm: 'max-w-md',\n        md: 'max-w-lg',\n        lg: 'max-w-2xl',\n        xl: 'max-w-4xl'\n      };\n      return map[this.maxWidth] || 'max-w-2xl';\n    }\n  },\n  methods: {\n    close() {\n      this.$emit('update:modelValue', false);\n      this.$emit('close');\n    }\n  }\n};","map":{"version":3,"names":["X","name","components","props","modelValue","type","Boolean","default","title","String","maxWidth","emits","computed","maxWidthClass","map","sm","md","lg","xl","methods","close","$emit"],"sources":["C:\\Users\\jayde\\Desktop\\frameVue\\src\\components\\common\\Modal.vue"],"sourcesContent":["<template>\n  <teleport to=\"body\">\n    <transition\n      enter-active-class=\"transition ease-out duration-200\"\n      enter-from-class=\"opacity-0\"\n      enter-to-class=\"opacity-100\"\n      leave-active-class=\"transition ease-in duration-150\"\n      leave-from-class=\"opacity-100\"\n      leave-to-class=\"opacity-0\"\n    >\n      <div\n        v-if=\"modelValue\"\n        class=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-charcoal-950/60 backdrop-blur-xs overflow-y-auto\"\n        role=\"dialog\"\n        aria-modal=\"true\"\n        @click.self=\"close\"\n      >\n        <div\n          :class=\"[\n            'relative w-full bg-white rounded-2xl shadow-elevated border border-cream-200 overflow-hidden my-8',\n            maxWidthClass\n          ]\"\n        >\n          <div class=\"flex items-center justify-between px-6 py-4 border-b border-cream-200 bg-cream-50\">\n            <h3 class=\"text-lg font-serif font-semibold text-charcoal-900\">\n              {{ title }}\n            </h3>\n            <button\n              type=\"button\"\n              class=\"p-2 rounded-full text-charcoal-800/70 hover:text-charcoal-900 hover:bg-cream-200 transition-colors\"\n              @click=\"close\"\n              aria-label=\"Close modal\"\n            >\n              <X class=\"w-5 h-5\" />\n            </button>\n          </div>\n\n          <div class=\"p-6 max-h-[80vh] overflow-y-auto\">\n            <slot />\n          </div>\n\n          <div\n            v-if=\"$slots.footer\"\n            class=\"px-6 py-4 bg-cream-50 border-t border-cream-200 flex items-center justify-end gap-3\"\n          >\n            <slot name=\"footer\" />\n          </div>\n        </div>\n      </div>\n    </transition>\n  </teleport>\n</template>\n\n<script>\nimport { X } from 'lucide-vue-next'\n\nexport default {\n  name: 'ModalDialog',\n  components: { X },\n  props: {\n    modelValue: {\n      type: Boolean,\n      default: false\n    },\n    title: {\n      type: String,\n      default: 'Details'\n    },\n    maxWidth: {\n      type: String,\n      default: 'lg'\n    }\n  },\n  emits: ['update:modelValue', 'close'],\n  computed: {\n    maxWidthClass() {\n      const map = {\n        sm: 'max-w-md',\n        md: 'max-w-lg',\n        lg: 'max-w-2xl',\n        xl: 'max-w-4xl'\n      }\n      return map[this.maxWidth] || 'max-w-2xl'\n    }\n  },\n  methods: {\n    close() {\n      this.$emit('update:modelValue', false)\n      this.$emit('close')\n    }\n  }\n}\n</script>\n"],"mappings":"AAsDA,SAASA,CAAA,QAAS,iBAAgB;AAElC,eAAe;EACbC,IAAI,EAAE,aAAa;EACnBC,UAAU,EAAE;IAAEF;EAAE,CAAC;EACjBG,KAAK,EAAE;IACLC,UAAU,EAAE;MACVC,IAAI,EAAEC,OAAO;MACbC,OAAO,EAAE;IACX,CAAC;IACDC,KAAK,EAAE;MACLH,IAAI,EAAEI,MAAM;MACZF,OAAO,EAAE;IACX,CAAC;IACDG,QAAQ,EAAE;MACRL,IAAI,EAAEI,MAAM;MACZF,OAAO,EAAE;IACX;EACF,CAAC;EACDI,KAAK,EAAE,CAAC,mBAAmB,EAAE,OAAO,CAAC;EACrCC,QAAQ,EAAE;IACRC,aAAaA,CAAA,