{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport { ShieldCheck, Sparkles, Truck } from 'lucide-vue-next';\nimport { formatCurrency, formatSizeLabel } from '@/utils/formatters';\nexport default {\n  name: 'OrderSummary',\n  components: {\n    ShieldCheck,\n    Sparkles,\n    Truck\n  },\n  props: {\n    title: {\n      type: String,\n      default: 'Order Summary'\n    },\n    subtotal: {\n      type: Number,\n      default: 799\n    },\n    delivery: {\n      type: Number,\n      default: 100\n    },\n    total: {\n      type: Number,\n      default: 899\n    },\n    showCustomizationDetails: {\n      type: Boolean,\n      default: false\n    },\n    frame: {\n      type: Object,\n      default: null\n    },\n    design: {\n      type: Object,\n      default: null\n    },\n    size: {\n      type: String,\n      default: '8x10'\n    },\n    quantity: {\n      type: Number,\n      default: 1\n    },\n    photo: {\n      type: String,\n      default: ''\n    },\n    photos: {\n      type: Array,\n      default: () => []\n    },\n    customText: {\n      type: Object,\n      default: () => ({})\n    }\n  },\n  computed: {\n    resolvedPhotos() {\n      if (Array.isArray(this.photos) && this.photos.length > 0) {\n        return this.photos.map(p => typeof p === 'string' ? p : p?.url).filter(Boolean);\n      }\n      if (this.photo) return [this.photo];\n      return [];\n    },\n    primaryPhoto() {\n      return this.resolvedPhotos[0] || this.photo || '';\n    }\n  },\n  methods: {\n    formatCurrency,\n    formatSizeLabel\n  }\n};","map":{"version":3,"names":["ShieldCheck","Sparkles","Truck","formatCurrency","formatSizeLabel","name","components","props","title","type","String","default","subtotal","Number","delivery","total","showCustomizationDetails","Boolean","frame","Object","design","size","quantity","photo","photos","Array","customText","computed","resolvedPhotos","isArray","length","map","p","url","filter","primaryPhoto","methods"],"sources":["C:\\Users\\jayde\\Desktop\\frameVue\\src\\components\\customer\\OrderSummary.vue"],"sourcesContent":["<template>\n  <div class=\"bg-white rounded-2xl border border-cream-200 p-6 shadow-soft space-y-5\">\n    <div class=\"flex items-center justify-between border-b border-cream-200 pb-4\">\n      <h3 class=\"text-lg font-serif font-semibold text-charcoal-900\">\n        {{ title }}\n      </h3>\n      <ShieldCheck class=\"w-5 h-5 text-gold-600\" />\n    </div>\n\n    <!-- Optional Customization Summary Details -->\n    <div v-if=\"showCustomizationDetails && frame\" class=\"space-y-3 text-sm border-b border-cream-200 pb-4\">\n      <div class=\"flex items-center gap-3 pb-2\">\n        <img\n          v-if=\"primaryPhoto || frame.image\"\n          :src=\"primaryPhoto || frame.image\"\n          :alt=\"frame.name\"\n          class=\"w-14 h-14 rounded-xl object-cover border border-cream-300 shrink-0\"\n        />\n        <div class=\"min-w-0\">\n          <p class=\"font-serif font-semibold text-charcoal-900 truncate\">\n            {{ frame.name }}\n          </p>\n          <p class=\"text-xs text-charcoal-800/65\">\n            Design: <strong class=\"text-charcoal-900\">{{ design?.name || 'Romantic Gold' }}</strong>\n          </p>\n        </div>\n      </div>\n\n      <!-- Multi-Photo Thumbnails Strip -->\n      <div v-if=\"resolvedPhotos.length > 1\" class=\"flex items-center gap-1.5 overflow-x-auto pb-1\">\n        <img\n          v-for=\"(imgUrl, i) in resolvedPhotos\"\n          :key=\"i\"\n          :src=\"imgUrl\"\n          :alt=\"`Photo ${i + 1}`\"\n          class=\"w-9 h-9 rounded-lg object-cover border border-cream-300 shrink-0\"\n        />\n      </div>\n\n      <div class=\"flex justify-between text-xs\">\n        <span class=\"text-charcoal-800/70\">Selected Frame</span>\n        <span class=\"font-semibold text-charcoal-900\">{{ frame.name }} ({{ frame.material }})</span>\n      </div>\n      <div class=\"flex justify-between text-xs\">\n        <span class=\"text-charcoal-800/70\">Selected Design</span>\n        <span class=\"font-semibold text-charcoal-900\">{{ design?.name }} ({{ design?.category }})</span>\n      </div>\n      <div class=\"flex justify-between text-xs\">\n        <span class=\"text-charcoal-800/70\">Selected Size</span>\n        <span class=\"font-semibold text-charcoal-900\">{{ formatSizeLabel(size) }} Inches</span>\n      </div>\n      <div class=\"flex justify-between text-xs\">\n        <span class=\"text-charcoal-800/70\">Quantity</span>\n        <span class=\"font-semibold text-charcoal-900\">{{ quantity }}</span>\n      </div>\n      <div class=\"flex justify-between text-xs\">\n        <span class=\"text-charcoal-800/70\">Photos</span>\n        <span class=\"font-semibold text-emerald-600\">\n          {{ resolvedPhotos.length > 0 ? `${resolvedPhotos.length} Uploaded ✓` : 'Not selected' }}\n        </span>\n      </div>\n      <div v-if=\"customText?.name || customText?.customMessage\" class=\"pt-2 border-t border-cream-100 space-y-1 text-xs\">\n        <span class=\"block text-charcoal-800/60\">Custom Engraving / Caption:</span>\n        <p class=\"font-serif italic text-charcoal-900\">\n          \"{{ customText.customMessage || 'Forever & Always' }}\" — {{ customText.name }}\n          <span v-if=\"customText.date\">({{ customText.date }})</span>\n        </p>\n      </div>\n    </div>\n\n    <!-- Pricing Breakdown -->\n    <div class=\"space-y-2.5 text-sm\">\n      <div class=\"flex items-center justify-between text-charcoal-800/80\">\n        <span>Subtotal</span>\n        <span class=\"font-semibold text-charcoal-900\">{{ formatCurrency(subtotal) }}</span>\n      </div>\n      <div class=\"flex items-center justify-between text-charcoal-800/80\">\n        <span>Insured Studio Delivery</span>\n        <span class=\"font-semibold text-charcoal-900\">\n          {{ delivery === 0 ? 'FREE' : formatCurrency(delivery) }}\n        </span>\n      </div>\n      <div class=\"pt-3 border-t border-cream-200 flex items-center justify-between\">\n        <span class=\"text-base font-serif font-semibold text-charcoal-900\">Total</span>\n        <span class=\"text-xl font-bold text-charcoal-900\">{{ formatCurrency(total) }}</span>\n      </div>\n    </div>\n\n    <!-- Primary CTA Slot -->\n    <div v-if=\"$slots.default\" class=\"pt-1\">\n      <slot />\n    </div>\n\n    <!-- Trust Badges -->\n    <div class=\"pt-2 border-t border-cream-100 grid grid-cols-2 gap-2 text-[11px] text-charcoal-800/65\">\n      <div class=\"flex items-center gap-1.5\">\n        <Sparkles class=\"w-3.5 h-3.5 text-gold-600 shrink-0\" />\n        <span>Museum Archival Print</span>\n      </div>\n      <div class=\"flex items-center gap-1.5\">\n        <Truck class=\"w-3.5 h-3.5 text-gold-600 shrink-0\" />\n        <span>Damage-Free Packaging</span>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { ShieldCheck, Sparkles, Truck } from 'lucide-vue-next'\nimport { formatCurrency, formatSizeLabel } from '@/utils/formatters'\n\nexport default {\n  name: 'OrderSummary',\n  components: {\n    ShieldCheck,\n    Sparkles,\n    Truck\n  },\n  props: {\n    title: {\n      type: String,\n      default: 'Order Summary'\n    },\n    subtotal: {\n      type: Number,\n      default: 799\n    },\n    delivery: {\n      type: Number,\n      default: 100\n    },\n    total: {\n      type: Number,\n      default: 899\n    },\n    showCustomizationDetails: {\n      type: Boolean,\n      default: false\n    },\n    frame: {\n      type: Object,\n      default: null\n    },\n    design: {\n      type: Object,\n      default: null\n    },\n    size: {\n      type: String,\n      default: '8x10'\n    },\n    quantity: {\n      type: Number,\n      default: 1\n    },\n    photo: {\n      type: String,\n      default: ''\n    },\n    photos: {\n      type: Array,\n      default: () => []\n    },\n    customText: {\n      type: Object,\n      default: () => ({})\n    }\n  },\n  computed: {\n    resolvedPhotos() {\n      if (Array.isArray(this.photos) && this.photos.length > 0) {\n        return this.photos.map(p => (typeof p === 'string' ? p : p?.url)).filter(Boolean)\n      }\n      if (this.photo) return [this.photo]\n      return []\n    },\n    primaryPhoto() {\n      return this.resolvedPhotos[0] || this.photo || ''\n    }\n  },\n  methods: {\n    formatCurrency,\n    formatSizeLabel\n  }\n}\n</script>\n"],"mappings":";;;AA4GA,SAASA,WAAW,EAAEC,QAAQ,EAAEC,KAAI,QAAS,iBAAgB;AAC7D,SAASC,cAAc,EAAEC,eAAc,QAAS,oBAAmB;AAEnE,eAAe;EACbC,IAAI,EAAE,cAAc;EACpBC,UAAU,EAAE;IACVN,WAAW;IACXC,QAAQ;IACRC;EACF,CAAC;EACDK,KAAK,EAAE;IACLC,KAAK,EAAE;MACLC,IAAI,EAAEC,MAAM;MACZC,OAAO,EAAE;IACX,CAAC;IACDC,QAAQ,EAAE;MACRH,IAAI,EAAEI,MAAM;MACZF,OAAO,EAAE;IACX,CAAC;IACDG,QAAQ,EAAE;MACRL,IAAI,EAAEI,MAAM;MACZF,OAAO,EAAE;IACX,CAAC;IACDI,KAAK,EAAE;MACLN,IAAI,EAAEI,MAAM;MACZF,OAAO,EAAE;IACX,CAAC;IACDK,wBAAwB,EAAE;MACxBP,IAAI,EAAEQ,OAAO;MACbN,OAAO,EAAE;IACX,CAAC;IACDO,KAAK,EAAE;MACLT,IAAI,EAAEU,MAAM;MACZR,OAAO,EAAE;IACX,CAAC;IACDS,MAAM,EAAE;MACNX,IAAI,EAAEU,MAAM;MACZR,OAAO,EAAE;IACX,CAAC;IACDU,IAAI,EAAE;MACJZ,IAAI,EAAEC,MAAM;MACZC,OAAO,EAAE;IACX,CAAC;IACDW,QAAQ,EAAE;MACRb,IAAI,EAAEI,MAAM;MACZF,OAAO,EAAE;IACX,CAAC;IACDY,KAAK,EAAE;MACLd,IAAI,EAAEC,MAAM;MACZC,OAAO,EAAE;IACX,CAAC;IACDa,MAAM,EAAE;MACNf,IAAI,EAAEgB,KAAK;MACXd,OAAO,EAAEA,CAAA,KAAM;IACjB,CAAC;IACDe,UAAU,EAAE;MACVjB,IAAI,EAAEU,MAAM;MACZR,OAAO,EAAEA,CAAA,MAAO,CAAC,CAAC;IACpB;EACF,CAAC;EACDgB,QAAQ,EAAE;IACRC,cAAcA,CAAA,EAAG;MACf,IAAIH,KAAK,CAACI,OAAO,CAAC,IAAI,CAACL,MAAM,KAAK,IAAI,CAACA,MAAM,CAACM,MAAK,GAAI,CAAC,EAAE;QACxD,OAAO,IAAI,CAACN,MAAM,CAACO,GAAG,CAACC,CAAA,IAAM,OAAOA,CAAA,KAAM,QAAO,GAAIA,CAAA,GAAIA,CAAC,EAAEC,GAAI,CAAC,CAACC,MAAM,CAACjB,OAAO;MAClF;MACA,IAAI,IAAI,CAACM,KAAK,EAAE,OAAO,CAAC,IAAI,CAACA,KAAK;MAClC,OAAO,EAAC;IACV,CAAC;IACDY,YAAYA,CAAA,EAAG;MACb,OAAO,IAAI,CAACP,cAAc,CAAC,CAAC,KAAK,IA