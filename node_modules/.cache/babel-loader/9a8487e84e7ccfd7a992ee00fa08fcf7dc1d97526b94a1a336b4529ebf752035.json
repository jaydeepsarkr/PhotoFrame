{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { mapGetters, mapActions } from 'vuex';\nimport { Frame, ShoppingBag, Sparkles, Menu, X, ChevronRight, ShieldCheck, Sun, Moon } from 'lucide-vue-next';\nexport default {\n  name: 'CustomerNavbar',\n  components: {\n    Frame,\n    ShoppingBag,\n    Sparkles,\n    Menu,\n    X,\n    ChevronRight,\n    ShieldCheck,\n    Sun,\n    Moon\n  },\n  data() {\n    return {\n      mobileMenuOpen: false\n    };\n  },\n  computed: {\n    ...mapGetters(['darkMode', 'allowThemeToggle', 'enableDesignSection', 'announcementBanner']),\n    ...mapGetters('cart', ['cartCount']),\n    ...mapGetters('customization', ['selectedFrame']),\n    defaultFrameId() {\n      return this.selectedFrame?.id || 1;\n    }\n  },\n  methods: {\n    ...mapActions(['toggleDarkMode']),\n    isExactActive(path) {\n      return this.$route.path === path;\n    },\n    isPathActive(prefix) {\n      return this.$route.path.startsWith(prefix);\n    },\n    async navigateSection(sectionId) {\n      this.mobileMenuOpen = false;\n      if (this.$route.path !== '/') {\n        await this.$router.push('/');\n      }\n      setTimeout(() => {\n        const el = document.getElementById(sectionId);\n        if (el) {\n          el.scrollIntoView({\n            behavior: 'smooth'\n          });\n        }\n      }, 100);\n    }\n  }\n};","map":{"version":3,"names":["mapGetters","mapActions","Frame","ShoppingBag","Sparkles","Menu","X","ChevronRight","ShieldCheck","Sun","Moon","name","components","data","mobileMenuOpen","computed","defaultFrameId","selectedFrame","id","methods","isExactActive","path","$route","isPathActive","prefix","startsWith","navigateSection","sectionId","$router","push","setTimeout","el","document","getElementById","scrollIntoView","behavior"],"sources":["C:\\Users\\jayde\\Desktop\\frameVue\\src\\components\\common\\Navbar.vue"],"sourcesContent":["<template>\n  <div class=\"sticky top-0 z-40\">\n    <!-- Announcement Banner Ribbon -->\n    <div\n      v-if=\"announcementBanner && announcementBanner.enabled && announcementBanner.text\"\n      class=\"bg-charcoal-950 text-gold-300 text-xs py-2 px-4 text-center border-b border-gold-800/40 font-medium tracking-wide flex items-center justify-center gap-2 shadow-sm\"\n    >\n      <span>{{ announcementBanner.text }}</span>\n    </div>\n\n    <header class=\"bg-cream-50/95 backdrop-blur-md border-b border-cream-200/80 transition-all\">\n      <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div class=\"flex items-center justify-between h-20\">\n          <!-- Brand Logo -->\n          <router-link\n            to=\"/\"\n            class=\"flex items-center gap-3 group focus:outline-none\"\n          >\n            <div class=\"w-10 h-10 rounded-xl bg-charcoal-900 dark:bg-gold-600 text-gold-400 dark:text-white flex items-center justify-center shadow-sm group-hover:bg-gold-600 group-hover:text-white transition-colors\">\n              <Frame class=\"w-5 h-5\" />\n            </div>\n            <div>\n              <span class=\"block text-xl font-serif font-bold tracking-tight text-charcoal-900\">\n                Atelier<span class=\"text-gold-600 dark:text-gold-400\">Cadre</span>\n              </span>\n              <span class=\"block text-[10px] uppercase tracking-[0.22em] text-charcoal-800/60 font-medium\">\n                Custom Framing Studio\n              </span>\n            </div>\n          </router-link>\n\n          <!-- Desktop Navigation -->\n          <nav class=\"hidden md:flex items-center gap-7\">\n            <router-link\n              to=\"/\"\n              class=\"text-sm font-medium transition-colors\"\n              :class=\"isExactActive('/') ? 'text-gold-600 font-semibold' : 'text-charcoal-800/80 hover:text-charcoal-900'\"\n            >\n              Home\n            </router-link>\n            <router-link\n              to=\"/frames\"\n              class=\"text-sm font-medium transition-colors\"\n              :class=\"isPathActive('/frames') ? 'text-gold-600 font-semibold' : 'text-charcoal-800/80 hover:text-charcoal-900'\"\n            >\n              Frames\n            </router-link>\n            <!-- Designs link (hidden if disabled in studio settings) -->\n            <router-link\n              v-if=\"enableDesignSection\"\n              :to=\"`/customize/${defaultFrameId}`\"\n              class=\"text-sm font-medium transition-colors\"\n              :class=\"isPathActive('/customize') ? 'text-gold-600 font-semibold' : 'text-charcoal-800/80 hover:text-charcoal-900'\"\n            >\n              Designs\n            </router-link>\n            <a\n              href=\"/#how-it-works\"\n              class=\"text-sm font-medium text-charcoal-800/80 hover:text-charcoal-900 transition-colors\"\n              @click.prevent=\"navigateSection('how-it-works')\"\n            >\n              How It Works\n            </a>\n            <a\n              href=\"/#contact\"\n              class=\"text-sm font-medium text-charcoal-800/80 hover:text-charcoal-900 transition-colors\"\n              @click.prevent=\"navigateSection('contact')\"\n            >\n              Contact\n            </a>\n          </nav>\n\n          <!-- Right Actions -->\n          <div class=\"hidden md:flex items-center gap-2.5\">\n            <!-- Dark Mode Toggle (Hidden if disabled in studio settings) -->\n            <button\n              v-if=\"allowThemeToggle\"\n              type=\"button\"\n              class=\"p-2.5 rounded-xl bg-white hover:bg-cream-100 text-charcoal-900 border border-cream-300 transition-colors shadow-sm\"\n              :title=\"darkMode ? 'Switch to Light Mode' : 'Switch to Dark Mode'\"\n              aria-label=\"Toggle dark mode\"\n              @click=\"handleThemeToggle\"\n            >\n              <Sun v-if=\"darkMode\" class=\"w-4 h-4 text-gold-400\" />\n              <Moon v-else class=\"w-4 h-4 text-charcoal-800\" />\n            </button>\n\n          <router-link\n            to=\"/admin\"\n            class=\"inline-flex items-center gap-1.5 px-3.5 py-2.5 rounded-xl text-xs font-medium text-charcoal-800/80 hover:text-charcoal-900 bg-cream-100 hover:bg-cream-200 border border-cream-300/70 transition-colors\"\n            title=\"Switch to Admin Panel\"\n          >\n            <ShieldCheck class=\"w-4 h-4 text-gold-600\" />\n            <span>Admin</span>\n          </router-link>\n\n          <router-link\n            to=\"/cart\"\n            class=\"relative inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white hover:bg-cream-100 text-charcoal-900 border border-cream-300 text-sm font-medium transition-all shadow-sm\"\n          >\n            <ShoppingBag class=\"w-4 h-4 text-gold-600\" />\n            <span>Cart</span>\n            <span\n              v-if=\"cartCount > 0\"\n              class=\"ml-0.5 inline-flex items-center justify-center min-w-[20px] h-5 px-1.5 rounded-full bg-gold-600 text-white text-xs font-semibold\"\n            >\n              {{ cartCount }}\n            </span>\n          </router-link>\n\n          <router-link\n            :to=\"`/customize/${defaultFrameId}`\"\n            class=\"inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-charcoal-900 dark:bg-gold-600 hover:bg-gold-600 dark:hover:bg-gold-500 text-white text-sm font-medium transition-colors shadow-sm\"\n          >\n            <Sparkles class=\"w-4 h-4\" />\n            <span>Create Frame</span>\n          </router-link>\n        </div>\n\n        <!-- Mobile Menu, Dark Mode & Cart Trigger -->\n        <div class=\"flex items-center gap-2 md:hidden\">\n          <!-- Mobile Dark Mode Button (Hidden if disabled in studio settings) -->\n          <button\n            v-if=\"allowThemeToggle\"\n            type=\"button\"\n            class=\"p-2.5 rounded-xl bg-white border border-cream-300 text-charcoal-900\"\n            aria-label=\"Toggle dark mode\"\n            @click=\"handleThemeToggle\"\n          >\n            <Sun v-if=\"darkMode\" class=\"w-5 h-5 text-gold-400\" />\n            <Moon v-else class=\"w-5 h-5 text-charcoal-800\" />\n          </button>\n\n          <router-link\n            to=\"/cart\"\n            class=\"relative p-2.5 rounded-xl bg-white border border-cream-300 text-charcoal-900\"\n            aria-label=\"Shopping Cart\"\n          >\n            <ShoppingBag class=\"w-5 h-5 text-gold-600\" />\n            <span\n              v-if=\"cartCount > 0\"\n              class=\"absolute -top-1.5 -right-1.5 min-w-[18px] h-[18px] px-1 rounded-full bg-gold-600 text-white text-[10px] font-bold flex items-center justify-center\"\n            >\n              {{ cartCount }}\n            </span>\n          </router-link>\n\n          <button\n            type=\"button\"\n            class=\"p-2.5 rounded-xl bg-white border border-cream-300 text-charcoal-900 hover:bg-cream-100 transition-colors\"\n            @click=\"mobileMenuOpen = !mobileMenuOpen\"\n            aria-label=\"Toggle navigation menu\"\n          >\n            <X v-if=\"mobileMenuOpen\" class=\"w-5 h-5\" />\n            <Menu v-else class=\"w-5 h-5\" />\n          </button>\n        </div>\n      </div>\n    </div>\n\n    <!-- Mobile Dropdown Menu -->\n    <transition\n      enter-active-class=\"transition ease-out duration-200\"\n      enter-from-class=\"opacity-0 -translate-y-2\"\n      enter-to-class=\"opacity-100 translate-y-0\"\n      leave-active-class=\"transition ease-in duration-150\"\n      leave-from-class=\"opacity-100 translate-y-0\"\n      leave-to-class=\"opacity-0 -translate-y-2\"\n    >\n      <div\n        v-if=\"mobileMenuOpen\"\n        class=\"md:hidden bg-white border-b border-cream-200 px-4 pt-3 pb-6 space-y-2 shadow-elevated\"\n      >\n        <router-link\n          to=\"/\"\n          class=\"flex items-center justify-between px-4 py-3 rounded-xl text-sm font-medium text-charcoal-900 hover:bg-cream-100\"\n          @click=\"mobileMenuOpen = false\"\n        >\n          <span>Home</span>\n          <ChevronRight class=\"w-4 h-4 text-charcoal-800/40\" />\n        </router-link>\n        <router-link\n          to=\"/frames\"\n          class=\"flex items-center justify-between px-4 py-3 rounded-xl text-sm font-medium text-charcoal-900 hover:bg-cream-100\"\n          @click=\"mobileMenuOpen = false\"\n        >\n          <span>Browse Frames</span>\n          <ChevronRight class=\"w-4 h-4 text-charcoal-800/40\" />\n        </router-link>\n        <!-- Mobile Designs link (hidden if disabled) -->\n        <router-link\n          v-if=\"enableDesignSection\"\n          :to=\"`/customize/${defaultFrameId}`\"\n          class=\"flex items-center justify-between px-4 py-3 rounded-xl text-sm font-medium text-charcoal-900 hover:bg-cream-100\"\n          @click=\"mobileMenuOpen = false\"\n        >\n          <span>Designs &amp; Customize</span>\n          <ChevronRight class=\"w-4 h-4 text-charcoal-800/40\" />\n        </router-link>\n        <a\n          href=\"/#how-it-works\"\n          class=\"flex items-center justify-between px-4 py-3 rounded-xl text-sm font-medium text-charcoal-900 hover:bg-cream-100\"\n          @click.prevent=\"navigateSection('how-it-works')\"\n        >\n          <span>How It Works</span>\n          <ChevronRight class=\"w-4 h-4 text-charcoal-800/40\" />\n        </a>\n        <a\n          href=\"/#contact\"\n          class=\"flex items-center justify-between px-4 py-3 rounded-xl text-sm font-medium text-charcoal-900 hover:bg-cream-100\"\n          @click.prevent=\"navigateSection('contact')\"\n        >\n          <span>Contact</span>\n          <ChevronRight class=\"w-4 h-4 text-charcoal-800/40\" />\n        </a>\n        <router-link\n          to=\"/admin\"\n          class=\"flex items-center justify-between px-4 py-3 rounded-xl text-sm font-medium text-gold-600 bg-cream-100\"\n          @click=\"mobileMenuOpen = false\"\n        >\n          <span class=\"flex items-center gap-2\">\n            <ShieldCheck class=\"w-4 h-4\" />\n            Admin Dashboard\n          </span>\n          <ChevronRight class=\"w-4 h-4\" />\n        </router-link>\n\n        <div class=\"pt-2\">\n          <router-link\n            :to=\"`/customize/${defaultFrameId}`\"\n            class=\"w-full flex items-center justify-center gap-2 px-5 py-3.5 rounded-xl bg-charcoal-900 dark:bg-gold-600 text-white text-sm font-semibold shadow-sm\"\n            @click=\"mobileMenuOpen = false\"\n          >\n            <Sparkles class=\"w-4 h-4 text-gold-300\" />\n            <span>Create Your Custom Frame</span>\n          </router-link>\n        </div>\n      </div>\n    </transition>\n  </header>\n</div>\n</template>\n\n<script>\nimport { mapGetters, mapActions } from 'vuex'\nimport {\n  Frame,\n  ShoppingBag,\n  Sparkles,\n  Menu,\n  X,\n  ChevronRight,\n  ShieldCheck,\n  Sun,\n  Moon\n} from 'lucide-vue-next'\n\nexport default {\n  name: 'CustomerNavbar',\n  components: {\n    Frame,\n    ShoppingBag,\n    Sparkles,\n    Menu,\n    X,\n    ChevronRight,\n    ShieldCheck,\n    Sun,\n    Moon\n  },\n  data() {\n    return {\n      mobileMenuOpen: false\n    }\n  },\n  computed: {\n    ...mapGetters(['darkMode', 'allowThemeToggle', 'enableDesignSection', 'announcementBanner']),\n    ...mapGetters('cart', ['cartCount']),\n    ...mapGetters('customization', ['selectedFrame']),\n    defaultFrameId() {\n      return this.selectedFrame?.id || 1\n    }\n  },\n  methods: {\n    ...mapActions(['toggleDarkMode']),\n    isExactActive(path) {\n      return this.$route.path === path\n    },\n    isPathActive(prefix) {\n      return this.$route.path.startsWith(prefix)\n    },\n    async navigateSection(sectionId) {\n      this.mobileMenuOpen = false\n      if (this.$route.path !== '/') {\n        await this.$router.push('/')\n      }\n      setTimeout(() => {\n        const el = document.getElementById(sectionId)\n        if (el) {\n          el.scrollIntoView({ behavior: 'smooth' })\n        }\n      }, 100)\n    }\n  }\n}\n</script>\n"],"mappings":";AAoPA,SAASA,UAAU,EAAEC,UAAS,QAAS,MAAK;AAC5C,SACEC,KAAK,EACLC,WAAW,EACXC,QAAQ,EACRC,IAAI,EACJC,CAAC,EACDC,YAAY,EACZC,WAAW,EACXC,GAAG,EACHC,IAAG,QACE,iBAAgB;AAEvB,eAAe;EACbC,IAAI,EAAE,gBAAgB;EACtBC,UAAU,EAAE;IACVV,KAAK;IACLC,WAAW;IACXC,QAAQ;IACRC,IAAI;IACJC,CAAC;IACDC,YAAY;IACZC,WAAW;IACXC,GAAG;IACHC;EACF,CAAC;EACDG,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,cAAc,EAAE;IAClB;EACF,CAAC;EACDC,QAAQ,EAAE;IACR,GAAGf,UAAU,CAAC,CAAC,UAAU,EAAE,kBAAkB,EAAE,qBAAqB,EAAE,oBAAoB,CAAC,CAAC;IAC5F,GAAGA,UAAU,CAAC,MAAM,EAAE,CAAC,WAAW,CAAC,CAAC;IACpC,GAAGA,UAAU,CAAC,eAAe,EAAE,CAAC,eAAe,CAAC,CAAC;IACjDgB,cAAcA,CAAA,EAAG;MACf,OAAO,IAAI,CAACC,aAAa,EAAEC,EAAC,IAAK;IACnC;EACF,CAAC;EACDC,OAAO,EAAE;IACP,GAAGlB,UAAU,CAAC,CAAC,gBAAgB,CAAC,CAAC;IACjCmB,aAAaA,CAACC,IAAI,EAAE;MAClB,OAAO,IAAI,CAACC,MAAM,CAACD,IAAG,KAAMA,IAAG;IACjC,CAAC;IACDE,YAAYA,CAACC,MAAM,EAAE;MACnB,OAAO,IAAI,CAACF,MAAM,CAACD,IAAI,CAACI,UAAU,CAACD,MAAM;IAC3C,CAAC;IACD,MAAME,eAAeA,CAACC,SAAS,EAAE;MAC/B,IAAI,CAACb,cAAa,GAAI,KAAI;MAC1B,IAAI,IAAI,CAACQ,MAAM,CAACD,IAAG,KAAM,GAAG,EAAE;QAC5B,MAAM,IAAI,CAACO,OAAO,CAACC,IAAI,CAAC,GAAG;MAC7B;MACAC,UAAU,CAAC,MAAM;QACf,MAAMC,EAAC,GAAIC,QAAQ,CAACC,cAAc,CAACN,SAAS;QAC5C,IAAII,EAAE,EAAE;UACNA,EAAE,CAACG,cAAc,CAAC;YAAEC,QAAQ,EAAE;UAAS,CAAC;QAC1C;MACF,CAAC,EAAE,GAAG;IACR;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}