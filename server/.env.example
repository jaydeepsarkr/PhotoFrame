PORT=5000
NODE_ENV=development

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/framevue

# Cloudinary Credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# MailerSend (Email OTP)
MAILERSEND_API_KEY=mlsn.your_mailersend_api_key
MAILERSEND_USER=your_smtp_user@your_domain.mlsender.net
MAILERSEND_PASS=your_smtp_password
MAILERSEND_FROM_EMAIL=your_verified_sender@your_domain.mlsender.net
MAILERSEND_FROM_NAME="Atelier Cadre Security"

# Default Admin Credentials
ADMIN_EMAIL=admin@ateliercadre.in
ADMIN_PASSWORD=Admin@12345
ADMIN_REGISTRATION_SECRET=atelier2026
