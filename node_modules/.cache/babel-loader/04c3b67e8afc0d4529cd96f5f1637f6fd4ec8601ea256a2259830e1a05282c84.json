{"ast":null,"code":"import { Camera, Upload, RefreshCw, Trash2, CheckCircle2 } from 'lucide-vue-next';\nimport { uploadService } from '@/services/uploadService';\nexport default {\n  name: 'ImageUploader',\n  components: {\n    Camera,\n    Upload,\n    RefreshCw,\n    Trash2,\n    CheckCircle2\n  },\n  props: {\n    modelValue: {\n      type: String,\n      default: ''\n    },\n    label: {\n      type: String,\n      default: 'Upload Your Photo'\n    }\n  },\n  emits: ['update:modelValue', 'uploaded'],\n  data() {\n    return {\n      isDragging: false,\n      errorMessage: '',\n      samplePhotos: [{\n        label: 'Couple Portrait',\n        url: 'https://images.unsplash.com/photo-1522673607200-164d1b6ce486?auto=format&fit=crop&w=800&q=80'\n      }, {\n        label: 'Wedding Moment',\n        url: 'https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=800&q=80'\n      }, {\n        label: 'Family Joy',\n        url: 'https://images.unsplash.com/photo-1511895426328-dc8714191300?auto=format&fit=crop&w=800&q=80'\n      }, {\n        label: 'Childhood Smile',\n        url: 'https://images.unsplash.com/photo-1503454537195-1dcabb73ffb9?auto=format&fit=crop&w=800&q=80'\n      }]\n    };\n  },\n  methods: {\n    triggerFilePicker() {\n      this.$refs.fileInput?.click();\n    },\n    async onFileSelect(event) {\n      const file = event.target.files?.[0];\n      if (file) {\n        await this.processFile(file);\n      }\n      event.target.value = '';\n    },\n    async onDrop(event) {\n      this.isDragging = false;\n      const file = event.dataTransfer?.files?.[0];\n      if (file) {\n        await this.processFile(file);\n      }\n    },\n    async processFile(file) {\n      this.errorMessage = '';\n      try {\n        const result = await uploadService.readFileAsDataUrl(file);\n        this.$emit('update:modelValue', result.url);\n        this.$emit('uploaded', result);\n      } catch (err) {\n        this.errorMessage = err.message || 'Unable to load image file.';\n      }\n    },\n    removePhoto() {\n      this.$emit('update:modelValue', '');\n      this.$emit('uploaded', {\n        url: '',\n        name: ''\n      });\n    },\n    selectSample(sample) {\n      this.errorMessage = '';\n      this.$emit('update:modelValue', sample.url);\n      this.$emit('uploaded', {\n        url: sample.url,\n        name: `${sample.label}.jpg`\n      });\n    }\n  }\n};","map":{"version":3,"names":["Camera","Upload","RefreshCw","Trash2","CheckCircle2","uploadService","name","components","props","modelValue","type","String","default","label","emits","data","isDragging","errorMessage","samplePhotos","url","methods","triggerFilePicker","$refs","fileInput","click","onFileSelect","event","file","target","files","processFile","value","onDrop","dataTransfer","result","readFileAsDataUrl","$emit","err","message","removePhoto","selectSample","sample"],"sources":["C:\\Users\\jayde\\Desktop\\frameVue\\src\\components\\customer\\ImageUploader.vue"],"sourcesContent":["<template>\n  <div class=\"space-y-3\">\n    <div class=\"flex items-center justify-between\">\n      <label class=\"block text-sm font-serif font-semibold text-charcoal-900\">\n        {{ label }}\n      </label>\n      <span class=\"text-xs text-charcoal-800/60\">JPG, PNG or WEBP • High Resolution</span>\n    </div>\n\n    <!-- Dropzone / Preview Box -->\n    <div\n      :class=\"[\n        'relative rounded-2xl border-2 border-dashed transition-all p-6 text-center',\n        isDragging\n          ? 'border-gold-600 bg-gold-50/70'\n          : 'border-cream-300 bg-cream-50/70 hover:border-gold-400'\n      ]\"\n      @dragover.prevent=\"isDragging = true\"\n      @dragleave.prevent=\"isDragging = false\"\n      @drop.prevent=\"onDrop\"\n    >\n      <input\n        ref=\"fileInput\"\n        type=\"file\"\n        accept=\"image/*\"\n        class=\"hidden\"\n        @change=\"onFileSelect\"\n      />\n\n      <!-- When Photo Exists -->\n      <div v-if=\"modelValue\" class=\"flex flex-col sm:flex-row items-center gap-5 text-left\">\n        <div class=\"w-28 h-28 rounded-xl overflow-hidden border border-cream-300 bg-white shrink-0 shadow-sm\">\n          <img\n            :src=\"modelValue\"\n            alt=\"Uploaded preview\"\n            class=\"w-full h-full object-cover\"\n          />\n        </div>\n        <div class=\"flex-1 space-y-2 text-center sm:text-left\">\n          <div class=\"inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-200\">\n            <CheckCircle2 class=\"w-3.5 h-3.5\" />\n            Photo Ready for Framing\n          </div>\n          <p class=\"text-xs text-charcoal-800/70\">\n            Your photo is automatically centered and color-balanced in the live frame preview.\n          </p>\n          <div class=\"flex flex-wrap items-center justify-center sm:justify-start gap-2.5 pt-1\">\n            <button\n              type=\"button\"\n              class=\"inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-charcoal-900 hover:bg-gold-600 text-white text-xs font-semibold transition-colors\"\n              @click=\"triggerFilePicker\"\n            >\n              <RefreshCw class=\"w-3.5 h-3.5\" />\n              <span>Replace Photo</span>\n            </button>\n            <button\n              type=\"button\"\n              class=\"inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-white hover:bg-rose-50 text-rose-600 border border-rose-200 text-xs font-semibold transition-colors\"\n              @click=\"removePhoto\"\n            >\n              <Trash2 class=\"w-3.5 h-3.5\" />\n              <span>Remove Photo</span>\n            </button>\n          </div>\n        </div>\n      </div>\n\n      <!-- Empty Upload Prompt -->\n      <div v-else class=\"py-4 space-y-3\">\n        <div class=\"w-14 h-14 rounded-2xl bg-white border border-cream-300 shadow-sm flex items-center justify-center mx-auto text-gold-600\">\n          <Camera class=\"w-7 h-7\" />\n        </div>\n        <div>\n          <p class=\"text-sm font-semibold text-charcoal-900\">\n            Drag &amp; Drop Your Photo Here\n          </p>\n          <p class=\"text-xs text-charcoal-800/60 mt-0.5\">\n            or click below to select a portrait from your device\n          </p>\n        </div>\n        <div class=\"pt-1\">\n          <button\n            type=\"button\"\n            class=\"inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-charcoal-900 hover:bg-gold-600 text-white text-xs font-semibold transition-colors shadow-sm\"\n            @click=\"triggerFilePicker\"\n          >\n            <Upload class=\"w-4 h-4\" />\n            <span>Choose Photo</span>\n          </button>\n        </div>\n      </div>\n    </div>\n\n    <!-- Error Notice -->\n    <p v-if=\"errorMessage\" class=\"text-xs text-rose-600 font-medium\">\n      {{ errorMessage }}\n    </p>\n\n    <!-- Sample Preset Photos for Quick Testing -->\n    <div class=\"pt-1\">\n      <p class=\"text-[11px] uppercase tracking-wider text-charcoal-800/55 font-semibold mb-2\">\n        Or try a sample portrait:\n      </p>\n      <div class=\"flex items-center gap-2.5 overflow-x-auto pb-1\">\n        <button\n          v-for=\"(sample, idx) in samplePhotos\"\n          :key=\"idx\"\n          type=\"button\"\n          :class=\"[\n            'relative w-12 h-12 rounded-xl overflow-hidden border-2 transition-all shrink-0',\n            modelValue === sample.url ? 'border-gold-600 scale-105 shadow-sm' : 'border-transparent opacity-75 hover:opacity-100'\n          ]\"\n          :title=\"sample.label\"\n          @click=\"selectSample(sample)\"\n        >\n          <img :src=\"sample.url\" :alt=\"sample.label\" class=\"w-full h-full object-cover\" />\n        </button>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { Camera, Upload, RefreshCw, Trash2, CheckCircle2 } from 'lucide-vue-next'\nimport { uploadService } from '@/services/uploadService'\n\nexport default {\n  name: 'ImageUploader',\n  components: {\n    Camera,\n    Upload,\n    RefreshCw,\n    Trash2,\n    CheckCircle2\n  },\n  props: {\n    modelValue: {\n      type: String,\n      default: ''\n    },\n    label: {\n      type: String,\n      default: 'Upload Your Photo'\n    }\n  },\n  emits: ['update:modelValue', 'uploaded'],\n  data() {\n    return {\n      isDragging: false,\n      errorMessage: '',\n      samplePhotos: [\n        {\n          label: 'Couple Portrait',\n          url: 'https://images.unsplash.com/photo-1522673607200-164d1b6ce486?auto=format&fit=crop&w=800&q=80'\n        },\n        {\n          label: 'Wedding Moment',\n          url: 'https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=800&q=80'\n        },\n        {\n          label: 'Family Joy',\n          url: 'https://images.unsplash.com/photo-1511895426328-dc8714191300?auto=format&fit=crop&w=800&q=80'\n        },\n        {\n          label: 'Childhood Smile',\n          url: 'https://images.unsplash.com/photo-1503454537195-1dcabb73ffb9?auto=format&fit=crop&w=800&q=80'\n        }\n      ]\n    }\n  },\n  methods: {\n    triggerFilePicker() {\n      this.$refs.fileInput?.click()\n    },\n    async onFileSelect(event) {\n      const file = event.target.files?.[0]\n      if (file) {\n        await this.processFile(file)\n      }\n      event.target.value = ''\n    },\n    async onDrop(event) {\n      this.isDragging = false\n      const file = event.dataTransfer?.files?.[0]\n      if (file) {\n        await this.processFile(file)\n      }\n    },\n    async processFile(file) {\n      this.errorMessage = ''\n      try {\n        const result = await uploadService.readFileAsDataUrl(file)\n        this.$emit('update:modelValue', result.url)\n        this.$emit('uploaded', result)\n      } catch (err) {\n        this.errorMessage = err.message || 'Unable to load image file.'\n      }\n    },\n    removePhoto() {\n      this.$emit('update:modelValue', '')\n      this.$emit('uploaded', { url: '', name: '' })\n    },\n    selectSample(sample) {\n      this.errorMessage = ''\n      this.$emit('update:modelValue', sample.url)\n      this.$emit('uploaded', { url: sample.url, name: `${sample.label}.jpg` })\n    }\n  }\n}\n</script>\n"],"mappings":"AA2HA,SAASA,MAAM,EAAEC,MAAM,EAAEC,SAAS,EAAEC,MAAM,EAAEC,YAAW,QAAS,iBAAgB;AAChF,SAASC,aAAY,QAAS,0BAAyB;AAEvD,eAAe;EACbC,IAAI,EAAE,eAAe;EACrBC,UAAU,EAAE;IACVP,MAAM;IACNC,MAAM;IACNC,SAAS;IACTC,MAAM;IACNC;EACF,CAAC;EACDI,KAAK,EAAE;IACLC,UAAU,EAAE;MACVC,IAAI,EAAEC,MAAM;MACZC,OAAO,EAAE;IACX,CAAC;IACDC,KAAK,EAAE;MACLH,IAAI,EAAEC,MAAM;MACZC,OAAO,EAAE;IACX;EACF,CAAC;EACDE,KAAK,EAAE,CAAC,mBAAmB,EAAE,UAAU,CAAC;EACxCC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,UAAU,EAAE,KAAK;MACjBC,YAAY,EAAE,EAAE;MAChBC,YAAY,EAAE,CACZ;QACEL,KAAK,EAAE,iBAAiB;QACxBM,GAAG,EAAE;MACP,CAAC,EACD;QACEN,KAAK,EAAE,gBAAgB;QACvBM,GAAG,EAAE;MACP,CAAC,EACD;QACEN,KAAK,EAAE,YAAY;QACnBM,GAAG,EAAE;MACP,CAAC,EACD;QACEN,KAAK,EAAE,iBAAiB;QACxBM,GAAG,EAAE;MACP;IAEJ;EACF,CAAC;EACDC,OAAO,EAAE;IACPC,iBAAiBA,CAAA,EAAG;MAClB,IAAI,CAACC,KAAK,CAACC,SAAS,EAAEC,KAAK,CAAC;IAC9B,CAAC;IACD,MAAMC,YAAYA,CAACC,KAAK,EAAE;MACxB,MAAMC,IAAG,GAAID,KAAK,CAACE,MAAM,CAACC,KAAK,GAAG,CAAC;MACnC,IAAIF,IAAI,EAAE;QACR,MAAM,IAAI,CAACG,WAAW,CAACH,IAAI;MAC7B;MACAD,KAAK,CAACE,MAAM,CAACG,KAAI,GAAI,EAAC;IACxB,CAAC;IACD,MAAMC,MAAMA,CAACN,KAAK,EAAE;MAClB,IAAI,CAACV,UAAS,GAAI,KAAI;MACtB,MAAMW,IAAG,GAAID,KAAK,CAACO,YAAY,EAAEJ,KAAK,GAAG,CAAC;MAC1C,IAAIF,IAAI,EAAE;QACR,MAAM,IAAI,CAACG,WAAW,CAACH,IAAI;MAC7B;IACF,CAAC;IACD,MAAMG,WAAWA,CAACH,IAAI,EAAE;MACtB,IAAI,CAACV,YAAW,GAAI,EAAC;MACrB,IAAI;QACF,MAAMiB,MAAK,GAAI,MAAM7B,aAAa,CAAC8B,iBAAiB,CAACR,IAAI;QACzD,IAAI,CAACS,KAAK,CAAC,mBAAmB,EAAEF,MAAM,CAACf,GAAG;QAC1C,IAAI,CAACiB,KAAK,CAAC,UAAU,EAAEF,MAAM;MAC/B,EAAE,OAAOG,GAAG,EAAE;QACZ,IAAI,CAACpB,YAAW,GAAIoB,GAAG,CAACC,OAAM,IAAK,4BAA2B;MAChE;IACF,CAAC;IACDC,WAAWA,CAAA,EAAG;MACZ,IAAI,CAACH,KAAK,CAAC,mBAAmB,E