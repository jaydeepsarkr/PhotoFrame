{"ast":null,"code":"import \"core-js/modules/es.array.includes.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport { mapGetters } from 'vuex';\nimport OrderTable from '@/components/admin/OrderTable.vue';\nexport default {\n  name: 'AdminOrdersView',\n  components: {\n    OrderTable\n  },\n  data() {\n    return {\n      activeFilter: 'All',\n      searchQuery: '',\n      filterTabs: ['All', 'New', 'Confirmed', 'Processing', 'Ready', 'Shipped', 'Delivered', 'Cancelled']\n    };\n  },\n  computed: {\n    ...mapGetters('orders', ['allOrders']),\n    isCustomerDirectory() {\n      return this.$route.query.tab === 'customers';\n    },\n    filteredOrders() {\n      let list = [...this.allOrders];\n      if (this.activeFilter !== 'All') {\n        list = list.filter(o => o.status === this.activeFilter);\n      }\n      const q = this.searchQuery.toLowerCase();\n      if (q) {\n        list = list.filter(o => String(o.id).toLowerCase().includes(q) || String(o.customer?.fullName || '').toLowerCase().includes(q) || String(o.customer?.phone || '').toLowerCase().includes(q) || String(o.product?.frameName || '').toLowerCase().includes(q));\n      }\n      return list;\n    }\n  },\n  methods: {\n    getStatusCount(status) {\n      if (status === 'All') return this.allOrders.length;\n      return this.allOrders.filter(o => o.status === status).length;\n    }\n  }\n};","map":{"version":3,"names":["mapGetters","OrderTable","name","components","data","activeFilter","searchQuery","filterTabs","computed","isCustomerDirectory","$route","query","tab","filteredOrders","list","allOrders","filter","o","status","q","toLowerCase","String","id","includes","customer","fullName","phone","product","frameName","methods","getStatusCount","length"],"sources":["C:\\Users\\jayde\\Desktop\\frameVue\\src\\views\\admin\\Orders.vue"],"sourcesContent":["<template>\n  <div class=\"space-y-6\">\n    <!-- Top Filter & Search Bar -->\n    <div class=\"bg-white rounded-2xl border border-cream-200 p-5 shadow-soft space-y-4\">\n      <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <div>\n          <h2 class=\"text-xl font-serif font-bold text-charcoal-900\">\n            {{ isCustomerDirectory ? 'Customers Directory' : `Orders (${filteredOrders.length})` }}\n          </h2>\n          <p class=\"text-xs text-charcoal-800/65\">\n            {{ isCustomerDirectory ? 'Customer contact details and order history' : 'Track and update custom photo frame fulfillment statuses' }}\n          </p>\n        </div>\n\n        <input\n          v-model.trim=\"searchQuery\"\n          type=\"text\"\n          placeholder=\"Search Order ID, customer, phone...\"\n          class=\"px-3.5 py-2 rounded-xl bg-cream-50 border border-cream-300 text-xs text-charcoal-900 focus:outline-hidden focus:border-gold-600 w-full sm:w-64\"\n        />\n      </div>\n\n      <!-- Status Filter Pills -->\n      <div class=\"flex items-center gap-2 overflow-x-auto pb-1\">\n        <button\n          v-for=\"tab in filterTabs\"\n          :key=\"tab\"\n          type=\"button\"\n          :class=\"[\n            'px-3.5 py-1.5 rounded-full text-xs font-semibold whitespace-nowrap transition-all',\n            activeFilter === tab\n              ? 'bg-charcoal-900 text-white shadow-2xs'\n              : 'bg-cream-100 text-charcoal-800 hover:bg-cream-200'\n          ]\"\n          @click=\"activeFilter = tab\"\n        >\n          {{ tab }}\n          <span class=\"ml-1 opacity-70\">({{ getStatusCount(tab) }})</span>\n        </button>\n      </div>\n    </div>\n\n    <!-- Orders Table (Includes Phone Column) -->\n    <OrderTable\n      :orders=\"filteredOrders\"\n      :show-phone=\"true\"\n    />\n  </div>\n</template>\n\n<script>\nimport { mapGetters } from 'vuex'\nimport OrderTable from '@/components/admin/OrderTable.vue'\n\nexport default {\n  name: 'AdminOrdersView',\n  components: {\n    OrderTable\n  },\n  data() {\n    return {\n      activeFilter: 'All',\n      searchQuery: '',\n      filterTabs: [\n        'All',\n        'New',\n        'Confirmed',\n        'Processing',\n        'Ready',\n        'Shipped',\n        'Delivered',\n        'Cancelled'\n      ]\n    }\n  },\n  computed: {\n    ...mapGetters('orders', ['allOrders']),\n    isCustomerDirectory() {\n      return this.$route.query.tab === 'customers'\n    },\n    filteredOrders() {\n      let list = [...this.allOrders]\n      if (this.activeFilter !== 'All') {\n        list = list.filter(o => o.status === this.activeFilter)\n      }\n      const q = this.searchQuery.toLowerCase()\n      if (q) {\n        list = list.filter(\n          o =>\n            String(o.id).toLowerCase().includes(q) ||\n            String(o.customer?.fullName || '').toLowerCase().includes(q) ||\n            String(o.customer?.phone || '').toLowerCase().includes(q) ||\n            String(o.product?.frameName || '').toLowerCase().includes(q)\n        )\n      }\n      return list\n    }\n  },\n  methods: {\n    getStatusCount(status) {\n      if (status === 'All') return this.allOrders.length\n      return this.allOrders.filter(o => o.status === status).length\n    }\n  }\n}\n</script>\n"],"mappings":";;;AAmDA,SAASA,UAAS,QAAS,MAAK;AAChC,OAAOC,UAAS,MAAO,mCAAkC;AAEzD,eAAe;EACbC,IAAI,EAAE,iBAAiB;EACvBC,UAAU,EAAE;IACVF;EACF,CAAC;EACDG,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,YAAY,EAAE,KAAK;MACnBC,WAAW,EAAE,EAAE;MACfC,UAAU,EAAE,CACV,KAAK,EACL,KAAK,EACL,WAAW,EACX,YAAY,EACZ,OAAO,EACP,SAAS,EACT,WAAW,EACX,WAAU;IAEd;EACF,CAAC;EACDC,QAAQ,EAAE;IACR,GAAGR,UAAU,CAAC,QAAQ,EAAE,CAAC,WAAW,CAAC,CAAC;IACtCS,mBAAmBA,CAAA,EAAG;MACpB,OAAO,IAAI,CAACC,MAAM,CAACC,KAAK,CAACC,GAAE,KAAM,WAAU;IAC7C,CAAC;IACDC,cAAcA,CAAA,EAAG;MACf,IAAIC,IAAG,GAAI,CAAC,GAAG,IAAI,CAACC,SAAS;MAC7B,IAAI,IAAI,CAACV,YAAW,KAAM,KAAK,EAAE;QAC/BS,IAAG,GAAIA,IAAI,CAACE,MAAM,CAACC,CAAA,IAAKA,CAAC,CAACC,MAAK,KAAM,IAAI,CAACb,YAAY;MACxD;MACA,MAAMc,CAAA,GAAI,IAAI,CAACb,WAAW,CAACc,WAAW,CAAC