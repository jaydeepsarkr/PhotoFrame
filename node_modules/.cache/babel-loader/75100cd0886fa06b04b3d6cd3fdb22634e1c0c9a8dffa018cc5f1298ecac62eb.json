{"ast":null,"code":"import { mapGetters, mapActions } from 'vuex';\nimport { SunMoon, Sun, Moon, Laptop, LayoutGrid, Palette, Images, Type, MessageSquareQuote, Coins, Megaphone, Mail, RotateCcw, Save, RefreshCw, CheckCircle2, AlertCircle, Sparkles } from 'lucide-vue-next';\nexport default {\n  name: 'AdminSettings',\n  components: {\n    SunMoon,\n    Sun,\n    Moon,\n    Laptop,\n    LayoutGrid,\n    Palette,\n    Images,\n    Type,\n    MessageSquareQuote,\n    Coins,\n    Megaphone,\n    Mail,\n    RotateCcw,\n    Save,\n    RefreshCw,\n    CheckCircle2,\n    AlertCircle,\n    Sparkles\n  },\n  data() {\n    return {\n      saving: false,\n      statusMessage: '',\n      statusType: 'success',\n      form: {\n        allowThemeToggle: true,\n        themeMode: 'system',\n        enableDesignSection: true,\n        enableMultiPhotoUpload: true,\n        enableCustomText: true,\n        enableReviews: true,\n        currencySymbol: '₹',\n        deliveryFee: 100,\n        freeDeliveryThreshold: 2000,\n        announcementBanner: {\n          enabled: false,\n          text: ''\n        },\n        adminNotificationEmail: 'jaydeepsarkr@gmail.com',\n        notifyAdminOnNewOrder: true,\n        orderIdPrefix: 'PF'\n      }\n    };\n  },\n  computed: {\n    ...mapGetters('settings', ['allSettings'])\n  },\n  mounted() {\n    this.loadSettingsIntoForm();\n  },\n  methods: {\n    ...mapActions('settings', ['fetchSettings', 'updateSettings', 'resetSettings']),\n    loadSettingsIntoForm() {\n      const current = this.allSettings || {};\n      this.form = {\n        allowThemeToggle: current.allowThemeToggle !== false,\n        themeMode: current.themeMode || 'system',\n        enableDesignSection: current.enableDesignSection !== false,\n        enableMultiPhotoUpload: current.enableMultiPhotoUpload !== false,\n        enableCustomText: current.enableCustomText !== false,\n        enableReviews: current.enableReviews !== false,\n        currencySymbol: current.currencySymbol || '₹',\n        deliveryFee: Number(current.deliveryFee) || 100,\n        freeDeliveryThreshold: Number(current.freeDeliveryThreshold) || 2000,\n        announcementBanner: {\n          enabled: Boolean(current.announcementBanner?.enabled),\n          text: current.announcementBanner?.text || '✨ Limited Time: Handcrafted Italian Walnut finishes now available in all studio sizes!'\n        },\n        adminNotificationEmail: current.adminNotificationEmail || 'jaydeepsarkr@gmail.com',\n        notifyAdminOnNewOrder: current.notifyAdminOnNewOrder !== false,\n        orderIdPrefix: current.orderIdPrefix || 'PF'\n      };\n    },\n    async handleSaveSettings() {\n      this.saving = true;\n      this.statusMessage = '';\n      try {\n        await this.updateSettings(this.form);\n        this.statusType = 'success';\n        this.statusMessage = 'Settings saved successfully! Changes are now active across the entire platform.';\n      } catch (err) {\n        this.statusType = 'error';\n        this.statusMessage = err.message || 'Failed to save settings. Please try again.';\n      } finally {\n        this.saving = false;\n      }\n    },\n    async confirmReset() {\n      if (confirm('Are you sure you want to reset all studio settings to factory defaults?')) {\n        this.saving = true;\n        try {\n          await this.resetSettings();\n          this.loadSettingsIntoForm();\n          this.statusType = 'success';\n          this.statusMessage = 'All studio settings reset to factory defaults.';\n        } catch (err) {\n          this.statusType = 'error';\n          this.statusMessage = 'Failed to reset settings.';\n        } finally {\n          this.saving = false;\n        }\n      }\n    }\n  }\n};","map":{"version":3,"names":["mapGetters","mapActions","SunMoon","Sun","Moon","Laptop","LayoutGrid","Palette","Images","Type","MessageSquareQuote","Coins","Megaphone","Mail","RotateCcw","Save","RefreshCw","CheckCircle2","AlertCircle","Sparkles","name","components","data","saving","statusMessage","statusType","form","allowThemeToggle","themeMode","enableDesignSection","enableMultiPhotoUpload","enableCustomText","enableReviews","currencySymbol","deliveryFee","freeDeliveryThreshold","announcementBanner","enabled","text","adminNotificationEmail","notifyAdminOnNewOrder","orderIdPrefix","computed","mounted","loadSettingsIntoForm","methods","current","allSettings","Number","Boolean","handleSaveSettings","updateSettings","err","message","confirmReset","confirm","resetSettings"],"sources":["C:\\Users\\jayde\\Desktop\\frameVue\\src\\views\\admin\\Settings.vue"],"sourcesContent":["<template>\n  <div class=\"space-y-8 max-w-5xl mx-auto pb-12\">\n    <!-- Top Header -->\n    <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-cream-200 pb-6\">\n      <div>\n        <div class=\"flex items-center gap-2 mb-1\">\n          <span class=\"px-2.5 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider bg-gold-50 text-gold-800 border border-gold-200\">\n            Studio Controls\n          </span>\n          <span class=\"w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse\"></span>\n          <span class=\"text-xs text-emerald-700 font-medium\">Real-Time Sync</span>\n        </div>\n        <h1 class=\"text-2xl sm:text-3xl font-serif font-bold text-charcoal-900\">\n          Studio Settings &amp; Configuration\n        </h1>\n        <p class=\"text-xs sm:text-sm text-charcoal-800/70 mt-1\">\n          Manage storefront sections, light/dark theme modes, design template visibility, and pricing rules.\n        </p>\n      </div>\n\n      <!-- Action Buttons -->\n      <div class=\"flex items-center gap-3 shrink-0\">\n        <button\n          type=\"button\"\n          :disabled=\"saving\"\n          class=\"inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-rose-200 bg-rose-50 hover:bg-rose-100 text-rose-700 text-xs font-semibold transition-all disabled:opacity-50\"\n          @click=\"confirmReset\"\n        >\n          <RotateCcw class=\"w-3.5 h-3.5\" />\n          <span>Reset Defaults</span>\n        </button>\n\n        <button\n          type=\"button\"\n          :disabled=\"saving\"\n          class=\"inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-charcoal-900 dark:bg-gold-600 hover:bg-gold-600 text-white text-xs font-semibold transition-all shadow-md disabled:opacity-50\"\n          @click=\"handleSaveSettings\"\n        >\n          <RefreshCw v-if=\"saving\" class=\"w-3.5 h-3.5 animate-spin\" />\n          <Save v-else class=\"w-3.5 h-3.5 text-gold-300\" />\n          <span>{{ saving ? 'Saving Changes...' : 'Save Settings' }}</span>\n        </button>\n      </div>\n    </div>\n\n    <!-- Success / Error Banner Toast -->\n    <transition\n      enter-active-class=\"transition duration-300 ease-out\"\n      enter-from-class=\"opacity-0 -translate-y-2\"\n      enter-to-class=\"opacity-100 translate-y-0\"\n      leave-active-class=\"transition duration-200 ease-in\"\n      leave-from-class=\"opacity-100 translate-y-0\"\n      leave-to-class=\"opacity-0 -translate-y-2\"\n    >\n      <div\n        v-if=\"statusMessage\"\n        class=\"p-4 rounded-xl flex items-center justify-between border\"\n        :class=\"[\n          statusType === 'success'\n            ? 'bg-emerald-50 border-emerald-200 text-emerald-800'\n            : 'bg-rose-50 border-rose-200 text-rose-800'\n        ]\"\n      >\n        <div class=\"flex items-center gap-2.5 text-xs font-semibold\">\n          <CheckCircle2 v-if=\"statusType === 'success'\" class=\"w-4 h-4 text-emerald-600 shrink-0\" />\n          <AlertCircle v-else class=\"w-4 h-4 text-rose-600 shrink-0\" />\n          <span>{{ statusMessage }}</span>\n        </div>\n        <button type=\"button\" class=\"text-xs hover:opacity-75\" @click=\"statusMessage = ''\">✕</button>\n      </div>\n    </transition>\n\n    <!-- Quick Section Jump Navigation Pills -->\n    <div class=\"flex items-center gap-2 overflow-x-auto pb-1\">\n      <button\n        type=\"button\"\n        class=\"px-3.5 py-1.5 rounded-full text-xs font-semibold bg-white border border-cream-200 text-charcoal-800 hover:border-gold-400 hover:text-gold-600 transition-colors shrink-0 shadow-xs\"\n        @click=\"scrollToSection('section-appearance')\"\n      >\n        🎨 Theme &amp; Mode\n      </button>\n      <button\n        type=\"button\"\n        class=\"px-3.5 py-1.5 rounded-full text-xs font-semibold bg-white border border-cream-200 text-charcoal-800 hover:border-gold-400 hover:text-gold-600 transition-colors shrink-0 shadow-xs\"\n        @click=\"scrollToSection('section-catalog')\"\n      >\n        🖼️ Catalog &amp; Customizer\n      </button>\n      <button\n        type=\"button\"\n        class=\"px-3.5 py-1.5 rounded-full text-xs font-semibold bg-white border border-cream-200 text-charcoal-800 hover:border-gold-400 hover:text-gold-600 transition-colors shrink-0 shadow-xs\"\n        @click=\"scrollToSection('section-pricing')\"\n      >\n        💰 Pricing &amp; Rates\n      </button>\n      <button\n        type=\"button\"\n        class=\"px-3.5 py-1.5 rounded-full text-xs font-semibold bg-white border border-cream-200 text-charcoal-800 hover:border-gold-400 hover:text-gold-600 transition-colors shrink-0 shadow-xs\"\n        @click=\"scrollToSection('section-notifications')\"\n      >\n        📧 Order Alerts\n      </button>\n      <button\n        type=\"button\"\n        class=\"px-3.5 py-1.5 rounded-full text-xs font-semibold bg-gold-50 border border-gold-300 text-gold-900 hover:bg-gold-100 transition-colors shrink-0 shadow-xs flex items-center gap-1.5 font-bold\"\n        @click=\"scrollToSection('section-footer')\"\n      >\n        <span>⚓ Footer Details &amp; Links</span>\n      </button>\n    </div>\n\n    <!-- 1. APPEARANCE & THEME CONTROLS -->\n    <div id=\"section-appearance\" class=\"bg-white rounded-2xl border border-cream-200 p-6 sm:p-7 shadow-soft space-y-6\">\n      <div class=\"flex items-center justify-between border-b border-cream-200 pb-4\">\n        <div class=\"flex items-center gap-3\">\n          <div class=\"w-9 h-9 rounded-xl bg-gold-50 border border-gold-200 text-gold-700 flex items-center justify-center\">\n            <SunMoon class=\"w-5 h-5\" />\n          </div>\n          <div>\n            <h2 class=\"text-base sm:text-lg font-serif font-bold text-charcoal-900\">\n              Appearance &amp; Theme Mode\n            </h2>\n            <p class=\"text-xs text-charcoal-800/65\">\n              Control the dark mode toggle switch and enforce a global aesthetic across the website.\n            </p>\n          </div>\n        </div>\n        <span\n          class=\"px-2.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider\"\n          :class=\"[\n            form.allowThemeToggle\n              ? 'bg-emerald-50 text-emerald-700 border border-emerald-200'\n              : 'bg-charcoal-100 text-charcoal-600 border border-charcoal-200'\n          ]\"\n        >\n          {{ form.allowThemeToggle ? 'Switcher Active' : 'Switcher Off' }}\n        </span>\n      </div>\n\n      <!-- Feature 1: Allow / Turn Off Dark Mode Switcher -->\n      <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-4 rounded-xl bg-cream-50 border border-cream-200\">\n        <div>\n          <label class=\"block text-sm font-semibold text-charcoal-900\">\n            Allow Light / Dark Mode Toggle Switch\n          </label>\n          <p class=\"text-xs text-charcoal-800/65 mt-0.5 max-w-xl\">\n            When turned <strong>OFF</strong>, the Sun/Moon toggle button is completely hidden from the customer storefront header, mobile menu, and admin panel.\n          </p>\n        </div>\n        <button\n          type=\"button\"\n          :class=\"[\n            'relative inline-flex h-6 w-11 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none',\n            form.allowThemeToggle ? 'bg-gold-600' : 'bg-charcoal-300'\n          ]\"\n          @click=\"form.allowThemeToggle = !form.allowThemeToggle\"\n        >\n          <span\n            :class=\"[\n              'pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out',\n              form.allowThemeToggle ? 'translate-x-5' : 'translate-x-0'\n            ]\"\n          />\n        </button>\n      </div>\n\n      <!-- Feature 2: Force Specific Theme or Allow User Choice -->\n      <div>\n        <label class=\"block text-xs font-semibold uppercase tracking-wider text-charcoal-700 mb-3\">\n          Enforced Website Theme Palette\n        </label>\n        <div class=\"grid grid-cols-1 sm:grid-cols-3 gap-3.5\">\n          <!-- Light Only Card -->\n          <div\n            :class=\"[\n              'cursor-pointer p-4 rounded-xl border-2 transition-all flex flex-col justify-between gap-3',\n              form.themeMode === 'light'\n                ? 'border-gold-600 bg-gold-50/40 ring-2 ring-gold-500/20'\n                : 'border-cream-200 hover:border-gold-300 bg-white'\n            ]\"\n            @click=\"form.themeMode = 'light'\"\n          >\n            <div class=\"flex items-center justify-between\">\n              <div class=\"w-8 h-8 rounded-lg bg-amber-100 text-amber-800 flex items-center justify-center\">\n                <Sun class=\"w-4 h-4\" />\n              </div>\n              <span v-if=\"form.themeMode === 'light'\" class=\"text-gold-600 text-xs font-bold\">✓ Active</span>\n            </div>\n            <div>\n              <strong class=\"block text-sm text-charcoal-900 font-semibold\">Force Light Theme</strong>\n              <p class=\"text-[11px] text-charcoal-800/65 mt-1\">\n                Classic Atelier ivory &amp; warm cream museum gallery styling.\n              </p>\n            </div>\n          </div>\n\n          <!-- Dark Only Card -->\n          <div\n            :class=\"[\n              'cursor-pointer p-4 rounded-xl border-2 transition-all flex flex-col justify-between gap-3',\n              form.themeMode === 'dark'\n                ? 'border-gold-600 bg-gold-50/40 ring-2 ring-gold-500/20'\n                : 'border-cream-200 hover:border-gold-300 bg-white'\n            ]\"\n            @click=\"form.themeMode = 'dark'\"\n          >\n            <div class=\"flex items-center justify-between\">\n              <div class=\"w-8 h-8 rounded-lg bg-charcoal-900 text-gold-400 flex items-center justify-center\">\n                <Moon class=\"w-4 h-4\" />\n              </div>\n              <span v-if=\"form.themeMode === 'dark'\" class=\"text-gold-600 text-xs font-bold\">✓ Active</span>\n            </div>\n            <div>\n              <strong class=\"block text-sm text-charcoal-900 font-semibold\">Force Dark Theme</strong>\n              <p class=\"text-[11px] text-charcoal-800/65 mt-1\">\n                Midnight gallery palette with high-contrast gilded accents.\n              </p>\n            </div>\n          </div>\n\n          <!-- User Choice / System Card -->\n          <div\n            :class=\"[\n              'cursor-pointer p-4 rounded-xl border-2 transition-all flex flex-col justify-between gap-3',\n              form.themeMode === 'system'\n                ? 'border-gold-600 bg-gold-50/40 ring-2 ring-gold-500/20'\n                : 'border-cream-200 hover:border-gold-300 bg-white'\n            ]\"\n            @click=\"form.themeMode = 'system'\"\n          >\n            <div class=\"flex items-center justify-between\">\n              <div class=\"w-8 h-8 rounded-lg bg-cream-200 text-charcoal-800 flex items-center justify-center\">\n                <Laptop class=\"w-4 h-4\" />\n              </div>\n              <span v-if=\"form.themeMode === 'system'\" class=\"text-gold-600 text-xs font-bold\">✓ Active</span>\n            </div>\n            <div>\n              <strong class=\"block text-sm text-charcoal-900 font-semibold\">User Choice / System</strong>\n              <p class=\"text-[11px] text-charcoal-800/65 mt-1\">\n                Matches the visitor's device preference or toggle state.\n              </p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- 2. STOREFRONT & CATALOG SECTION TOGGLES -->\n    <div class=\"bg-white rounded-2xl border border-cream-200 p-6 sm:p-7 shadow-soft space-y-6\">\n      <div class=\"flex items-center justify-between border-b border-cream-200 pb-4\">\n        <div class=\"flex items-center gap-3\">\n          <div class=\"w-9 h-9 rounded-xl bg-gold-50 border border-gold-200 text-gold-700 flex items-center justify-center\">\n            <LayoutGrid class=\"w-5 h-5\" />\n          </div>\n          <div>\n            <h2 class=\"text-base sm:text-lg font-serif font-bold text-charcoal-900\">\n              Storefront &amp; Studio Sections\n            </h2>\n            <p class=\"text-xs text-charcoal-800/65\">\n              Enable or disable specific workflow steps and customer catalog sections.\n            </p>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"space-y-4\">\n        <!-- Feature 1: Turn off / on Design Section -->\n        <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-4 rounded-xl bg-cream-50 border border-cream-200\">\n          <div class=\"flex items-start gap-3.5\">\n            <div class=\"w-8 h-8 rounded-lg bg-gold-600/10 text-gold-700 flex items-center justify-center shrink-0 mt-0.5\">\n              <Palette class=\"w-4 h-4\" />\n            </div>\n            <div>\n              <div class=\"flex items-center gap-2\">\n                <label class=\"text-sm font-semibold text-charcoal-900\">\n                  Signature \"Design Templates\" Section\n                </label>\n                <span\n                  class=\"px-2 py-0.5 rounded-md text-[10px] font-bold uppercase tracking-wider\"\n                  :class=\"form.enableDesignSection ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800'\"\n                >\n                  {{ form.enableDesignSection ? 'Enabled' : 'Turned Off' }}\n                </span>\n              </div>\n              <p class=\"text-xs text-charcoal-800/65 mt-1 max-w-xl\">\n                When turned <strong>OFF</strong>, the signature design templates section is removed from the Home page showcase, hidden from the navigation bar, and bypassed in the Customizer stepper (customers jump directly from Frame selection to Photo upload).\n              </p>\n            </div>\n          </div>\n\n          <button\n            type=\"button\"\n            :class=\"[\n              'relative inline-flex h-6 w-11 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none',\n              form.enableDesignSection ? 'bg-gold-600' : 'bg-charcoal-300'\n            ]\"\n            @click=\"form.enableDesignSection = !form.enableDesignSection\"\n          >\n            <span\n              :class=\"[\n                'pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out',\n                form.enableDesignSection ? 'translate-x-5' : 'translate-x-0'\n              ]\"\n            />\n          </button>\n        </div>\n\n        <!-- Feature 2: Multi-Photo Collage Upload -->\n        <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-4 rounded-xl bg-cream-50 border border-cream-200\">\n          <div class=\"flex items-start gap-3.5\">\n            <div class=\"w-8 h-8 rounded-lg bg-gold-600/10 text-gold-700 flex items-center justify-center shrink-0 mt-0.5\">\n              <Images class=\"w-4 h-4\" />\n            </div>\n            <div>\n              <div class=\"flex items-center gap-2\">\n                <label class=\"text-sm font-semibold text-charcoal-900\">\n                  Multi-Photo Collage Upload (Up to 6 Photos)\n                </label>\n                <span\n                  class=\"px-2 py-0.5 rounded-md text-[10px] font-bold uppercase tracking-wider\"\n                  :class=\"form.enableMultiPhotoUpload ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800'\"\n                >\n                  {{ form.enableMultiPhotoUpload ? 'Enabled' : 'Single Only' }}\n                </span>\n              </div>\n              <p class=\"text-xs text-charcoal-800/65 mt-1 max-w-xl\">\n                Allow customers to upload multiple photos to create artistic photo collages. When turned off, customizer accepts 1 main portrait photo only.\n              </p>\n            </div>\n          </div>\n\n          <button\n            type=\"button\"\n            :class=\"[\n              'relative inline-flex h-6 w-11 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none',\n              form.enableMultiPhotoUpload ? 'bg-gold-600' : 'bg-charcoal-300'\n            ]\"\n            @click=\"form.enableMultiPhotoUpload = !form.enableMultiPhotoUpload\"\n          >\n            <span\n              :class=\"[\n                'pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out',\n                form.enableMultiPhotoUpload ? 'translate-x-5' : 'translate-x-0'\n              ]\"\n            />\n          </button>\n        </div>\n\n        <!-- Feature 3: Custom Inscription / Text Engraving -->\n        <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-4 rounded-xl bg-cream-50 border border-cream-200\">\n          <div class=\"flex items-start gap-3.5\">\n            <div class=\"w-8 h-8 rounded-lg bg-gold-600/10 text-gold-700 flex items-center justify-center shrink-0 mt-0.5\">\n              <Type class=\"w-4 h-4\" />\n            </div>\n            <div>\n              <div class=\"flex items-center gap-2\">\n                <label class=\"text-sm font-semibold text-charcoal-900\">\n                  Custom Inscription &amp; Matboard Engraving\n                </label>\n                <span\n                  class=\"px-2 py-0.5 rounded-md text-[10px] font-bold uppercase tracking-wider\"\n                  :class=\"form.enableCustomText ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800'\"\n                >\n                  {{ form.enableCustomText ? 'Enabled' : 'Disabled' }}\n                </span>\n              </div>\n              <p class=\"text-xs text-charcoal-800/65 mt-1 max-w-xl\">\n                Permit customers to enter personalized names, dates, quotes, and custom messages to be printed or foiled onto their matboard.\n              </p>\n            </div>\n          </div>\n\n          <button\n            type=\"button\"\n            :class=\"[\n              'relative inline-flex h-6 w-11 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none',\n              form.enableCustomText ? 'bg-gold-600' : 'bg-charcoal-300'\n            ]\"\n            @click=\"form.enableCustomText = !form.enableCustomText\"\n          >\n            <span\n              :class=\"[\n                'pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out',\n                form.enableCustomText ? 'translate-x-5' : 'translate-x-0'\n              ]\"\n            />\n          </button>\n        </div>\n\n        <!-- Feature 4: Customer Testimonials / Reviews -->\n        <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-4 rounded-xl bg-cream-50 border border-cream-200\">\n          <div class=\"flex items-start gap-3.5\">\n            <div class=\"w-8 h-8 rounded-lg bg-gold-600/10 text-gold-700 flex items-center justify-center shrink-0 mt-0.5\">\n              <MessageSquareQuote class=\"w-4 h-4\" />\n            </div>\n            <div>\n              <div class=\"flex items-center gap-2\">\n                <label class=\"text-sm font-semibold text-charcoal-900\">\n                  Customer Reviews &amp; Testimonials\n                </label>\n                <span\n                  class=\"px-2 py-0.5 rounded-md text-[10px] font-bold uppercase tracking-wider\"\n                  :class=\"form.enableReviews ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800'\"\n                >\n                  {{ form.enableReviews ? 'Enabled' : 'Hidden' }}\n                </span>\n              </div>\n              <p class=\"text-xs text-charcoal-800/65 mt-1 max-w-xl\">\n                Showcase verified collector reviews and gallery patron ratings on the storefront homepage.\n              </p>\n            </div>\n          </div>\n\n          <button\n            type=\"button\"\n            :class=\"[\n              'relative inline-flex h-6 w-11 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none',\n              form.enableReviews ? 'bg-gold-600' : 'bg-charcoal-300'\n            ]\"\n            @click=\"form.enableReviews = !form.enableReviews\"\n          >\n            <span\n              :class=\"[\n                'pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out',\n                form.enableReviews ? 'translate-x-5' : 'translate-x-0'\n              ]\"\n            />\n          </button>\n        </div>\n      </div>\n    </div>\n\n    <!-- 3. STORE PRICING, CURRENCY & ANNOUNCEMENT BANNER -->\n    <div class=\"bg-white rounded-2xl border border-cream-200 p-6 sm:p-7 shadow-soft space-y-6\">\n      <div class=\"flex items-center justify-between border