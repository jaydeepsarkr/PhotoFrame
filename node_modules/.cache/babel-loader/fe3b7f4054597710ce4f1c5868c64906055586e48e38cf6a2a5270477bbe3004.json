{"ast":null,"code":"import \"core-js/modules/es.array.includes.js\";\nimport { Sparkles, Camera } from 'lucide-vue-next';\nimport { formatSizeLabel } from '@/utils/formatters';\nexport default {\n  name: 'FramePreview',\n  components: {\n    Sparkles,\n    Camera\n  },\n  props: {\n    frame: {\n      type: Object,\n      default: () => ({})\n    },\n    design: {\n      type: Object,\n      default: () => ({})\n    },\n    size: {\n      type: String,\n      default: '8x10'\n    },\n    photo: {\n      type: String,\n      default: ''\n    },\n    customText: {\n      type: Object,\n      default: () => ({\n        name: 'Jay & Priya',\n        date: '30 September 2026',\n        customMessage: 'Forever & Always ❤️'\n      })\n    }\n  },\n  computed: {\n    frameTextureClass() {\n      if (this.frame?.borderTexture) return this.frame.borderTexture;\n      const mat = String(this.frame?.material || '').toLowerCase();\n      if (mat.includes('metal')) return 'frame-texture-gold';\n      if (mat.includes('acrylic')) return 'frame-texture-white';\n      if (mat.includes('composite')) return 'frame-texture-black';\n      return 'frame-texture-wood';\n    },\n    outerFrameInlineStyle() {\n      if (this.frame?.borderColor && !this.frame?.borderTexture) {\n        return {\n          backgroundColor: this.frame.borderColor\n        };\n      }\n      return {};\n    },\n    displayMessage() {\n      return this.customText?.customMessage?.trim() || 'Forever & Always ❤️';\n    },\n    displayName() {\n      return this.customText?.name?.trim() || 'Jay & Priya';\n    },\n    displayDate() {\n      return this.customText?.date?.trim() || '';\n    }\n  },\n  methods: {\n    formatSizeLabel\n  }\n};","map":{"version":3,"names":["Sparkles","Camera","formatSizeLabel","name","components","props","frame","type","Object","default","design","size","String","photo","customText","date","customMessage","computed","frameTextureClass","borderTexture","mat","material","toLowerCase","includes","outerFrameInlineStyle","borderColor","backgroundColor","displayMessage","trim","displayName","displayDate","methods"],"sources":["C:\\Users\\jayde\\Desktop\\frameVue\\src\\components\\customer\\FramePreview.vue"],"sourcesContent":["<template>\n  <div class=\"w-full\">\n    <div class=\"bg-gradient-to-b from-cream-100 to-cream-200/70 rounded-3xl p-5 sm:p-8 border border-cream-300/80 shadow-inner flex flex-col items-center justify-center relative overflow-hidden\">\n      <!-- Subtle Studio Wall Lighting Effect -->\n      <div class=\"absolute -top-24 left-1/2 -translate-x-1/2 w-80 h-48 bg-white/60 rounded-full blur-2xl pointer-events-none\"></div>\n\n      <!-- Top Info Pills -->\n      <div class=\"w-full flex flex-wrap items-center justify-between gap-2 mb-5 z-10\">\n        <span class=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-white/90 text-charcoal-900 border border-cream-300 shadow-2xs\">\n          <Sparkles class=\"w-3.5 h-3.5 text-gold-600\" />\n          Live Interactive Preview\n        </span>\n        <span class=\"px-3 py-1 rounded-full text-xs font-semibold bg-charcoal-900 text-cream-50\">\n          {{ formatSizeLabel(size) }} Inches\n        </span>\n      </div>\n\n      <!-- Outer Realistic Moulding Frame -->\n      <div\n        :class=\"[\n          'relative transition-all duration-300 rounded-md p-4 sm:p-6 w-full max-w-[380px]',\n          frameTextureClass\n        ]\"\n        :style=\"outerFrameInlineStyle\"\n      >\n        <!-- Inner Gold/Metallic Lip -->\n        <div\n          class=\"p-4 sm:p-6 transition-colors duration-300 relative frame-mat-bevel\"\n          :style=\"{\n            backgroundColor: design?.matColor || '#FDFBF7',\n            border: `1px solid ${design?.accentColor || '#D0A66B'}40`\n          }\"\n        >\n          <!-- Decorative Design Inner Border -->\n          <div\n            class=\"p-3 sm:p-4 relative transition-all duration-300\"\n            :style=\"{\n              border: `1.5px solid ${design?.accentColor || '#B07B38'}55`\n            }\"\n          >\n            <!-- Design Category Corner Ornament -->\n            <div\n              class=\"flex items-center justify-between text-[10px] uppercase tracking-[0.2em] mb-2.5 font-semibold\"\n              :style=\"{ color: design?.accentColor || '#B07B38' }\"\n            >\n              <span>{{ design?.category || 'Custom' }} Edition</span>\n              <span>{{ design?.badgeText || '✦' }}</span>\n            </div>\n\n            <!-- Customer Uploaded Photo Aperture -->\n            <div class=\"relative aspect-4/4 w-full overflow-hidden bg-cream-200 shadow-inner border border-black/10\">\n              <img\n                v-if=\"photo\"\n                :src=\"photo\"\n                alt=\"Customer Preview\"\n                class=\"w-full h-full object-cover transition-all duration-300\"\n              />\n              <div\n                v-else\n                class=\"w-full h-full flex flex-col items-center justify-center text-charcoal-800/50 p-6 text-center\"\n              >\n                <Camera class=\"w-8 h-8 mb-2 text-gold-600\" />\n                <span class=\"text-xs font-medium\">Upload a photo to preview inside your frame</span>\n              </div>\n            </div>\n\n            <!-- Personalized Caption Plaque Below Photo -->\n            <div class=\"pt-4 pb-1 text-center space-y-1\">\n              <p\n                class=\"font-serif italic text-sm sm:text-base font-medium leading-snug break-words\"\n                :style=\"{ color: '#191817' }\"\n              >\n                {{ displayMessage }}\n              </p>\n\n              <p\n                class=\"text-xs sm:text-sm font-serif font-semibold tracking-wide uppercase pt-0.5\"\n                :style=\"{ color: design?.accentColor || '#8F602D' }\"\n              >\n                {{ displayName }}\n              </p>\n\n              <p\n                v-if=\"displayDate\"\n                class=\"text-[11px] tracking-[0.15em] uppercase text-charcoal-800/60 font-medium\"\n              >\n                {{ displayDate }}\n              </p>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Bottom Caption Bar -->\n      <div class=\"mt-5 w-full flex flex-wrap items-center justify-between gap-2 text-xs text-charcoal-800/75 px-1\">\n        <div class=\"flex items-center gap-2\">\n          <span class=\"w-2.5 h-2.5 rounded-full\" :style=\"{ backgroundColor: frame?.borderColor || '#4A2E1B' }\"></span>\n          <span class=\"font-medium text-charcoal-900\">{{ frame?.name || 'Classic Wooden Frame' }}</span>\n        </div>\n        <div>\n          Design: <strong class=\"text-charcoal-900\">{{ design?.name || 'Romantic Gold' }}</strong>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { Sparkles, Camera } from 'lucide-vue-next'\nimport { formatSizeLabel } from '@/utils/formatters'\n\nexport default {\n  name: 'FramePreview',\n  components: {\n    Sparkles,\n    Camera\n  },\n  props: {\n    frame: {\n      type: Object,\n      default: () => ({})\n    },\n    design: {\n      type: Object,\n      default: () => ({})\n    },\n    size: {\n      type: String,\n      default: '8x10'\n    },\n    photo: {\n      type: String,\n      default: ''\n    },\n    customText: {\n      type: Object,\n      default: () => ({\n        name: 'Jay & Priya',\n        date: '30 September 2026',\n        customMessage: 'Forever & Always ❤️'\n      })\n    }\n  },\n  computed: {\n    frameTextureClass() {\n      if (this.frame?.borderTexture) return this.frame.borderTexture\n      const mat = String(this.frame?.material || '').toLowerCase()\n      if (mat.includes('metal')) return 'frame-texture-gold'\n      if (mat.includes('acrylic')) return 'frame-texture-white'\n      if (mat.includes('composite')) return 'frame-texture-black'\n      return 'frame-texture-wood'\n    },\n    outerFrameInlineStyle() {\n      if (this.frame?.borderColor && !this.frame?.borderTexture) {\n        return { backgroundColor: this.frame.borderColor }\n      }\n      return {}\n    },\n    displayMessage() {\n      return this.customText?.customMessage?.trim() || 'Forever & Always ❤️'\n    },\n    displayName() {\n      return this.customText?.name?.trim() || 'Jay & Priya'\n    },\n    displayDate() {\n      return this.customText?.date?.trim() || ''\n    }\n  },\n  methods: {\n    formatSizeLabel\n  }\n}\n</script>\n"],"mappings":";AA4GA,SAASA,QAAQ,EAAEC,MAAK,QAAS,iBAAgB;AACjD,SAASC,eAAc,QAAS,oBAAmB;AAEnD,eAAe;EACbC,IAAI,EAAE,cAAc;EACpBC,UAAU,EAAE;IACVJ,QAAQ;IACRC;EACF,CAAC;EACDI,KAAK,EAAE;IACLC,KAAK,EAAE;MACLC,IAAI,EAAEC,MAAM;MACZC,OAAO,EAAEA,CAAA,MAAO,CAAC,CAAC;IACpB,CAAC;IACDC,MAAM,EAAE;MACNH,IAAI,EAAEC,MAAM;MACZC,OAAO,EAAEA,CAAA,MAAO,CAAC,CAAC;IACpB,CAAC;IACDE,IAAI,EAAE;MACJJ,IAAI,EAAEK,MAAM;MACZH,OAAO,EAAE;IACX,CAAC;IACDI,KAAK,EAAE;MACLN,IAAI,EAAEK,MAAM;MACZH,OAAO,EAAE;IACX,CAAC;IACDK,UAAU,EAAE;MACVP,IAAI,EAAEC,MAAM;MACZC,OAAO,EAAEA,CAAA,MAAO;QACdN,IAAI,EAAE,aAAa;QACnBY,IAAI,EAAE,mBAAmB;QACzBC,aAAa,EAAE;MACjB,CAAC;IACH;EACF,CAAC;EACDC,QAAQ,EAAE;IACRC,iBAAiBA,CAAA,EAAG;MAClB,IAAI,IAAI,CAACZ,KAAK,EAAEa,aAAa,EAAE,OAAO,IAAI,CAACb,KAAK,CAACa,aAAY;MAC7D,MAAMC,GAAE,GAAIR,MAAM,CAAC,IAAI,CAACN,KAAK,EAAEe,QAAO,IAAK,EAAE,CAAC,CAACC,WAAW,CAAC;MAC3D,IAAIF,GAAG,CAACG,QAAQ,CAAC,OAAO,CAAC,EAAE,OAAO,oBAAmB;MACrD,IAAIH,GAAG,CAACG,QAAQ,CAAC,SAAS,CAAC,EAAE,OAAO,qBAAoB;MACxD,IAAIH,GAAG,CAACG,QAAQ,CAAC,WAAW,CAAC,EAAE,OAAO,qBAAoB;MAC1D,OAAO,oBAAmB;IAC5B,CAAC;IACDC,qBAAqBA,CAAA,EAAG;MACtB,IAAI,IAAI,CAAClB,KAAK,EAAEmB,WAAU,IAAK,CAAC,IAAI,CAACnB,KAAK,EAAEa,aAAa,EAAE;QACzD,OAAO;UAAEO,eAAe,EAAE,IAAI,CAACpB,KAAK,CAACmB;QAAY;MACnD;MACA,OAAO,CAAC;IACV,CAAC;IACDE,cAAcA,CAAA,EAAG;MACf,OAAO,IAAI,CAACb,UAAU,EAAEE,aAAa,EAAEY,IAAI,CAAC,KAAK,qBAAoB;IACvE,CAAC;IACDC,WAAWA,CAAA,EAAG;MACZ,OAAO,IAAI,CAACf,UAAU,EAAEX,IAAI,EAAEyB,IAAI,CAAC,KAAK,aAAY;IACtD,CAAC;IACDE,WAAWA,CAAA,EAAG;MACZ,OAAO