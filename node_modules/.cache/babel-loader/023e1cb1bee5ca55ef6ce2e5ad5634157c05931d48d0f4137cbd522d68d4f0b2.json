{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport { mapGetters } from 'vuex';\nimport { Plus, Pencil, Trash2 } from 'lucide-vue-next';\nimport StatusBadge from '@/components/common/StatusBadge.vue';\nimport ConfirmModal from '@/components/common/ConfirmModal.vue';\nexport default {\n  name: 'AdminDesignsView',\n  components: {\n    Plus,\n    Pencil,\n    Trash2,\n    StatusBadge,\n    ConfirmModal\n  },\n  data() {\n    return {\n      selectedCategory: 'All',\n      confirmDeleteOpen: false,\n      designToDelete: null\n    };\n  },\n  computed: {\n    ...mapGetters('designs', ['allDesigns', 'categories']),\n    filteredDesigns() {\n      if (this.selectedCategory === 'All') return this.allDesigns;\n      return this.allDesigns.filter(d => d.category === this.selectedCategory);\n    }\n  },\n  methods: {\n    promptDelete(design) {\n      this.designToDelete = design;\n      this.confirmDeleteOpen = true;\n    },\n    async confirmDelete() {\n      if (this.designToDelete) {\n        await this.$store.dispatch('designs/deleteDesign', this.designToDelete.id);\n        this.designToDelete = null;\n      }\n    }\n  }\n};","map":{"version":3,"names":["mapGetters","Plus","Pencil","Trash2","StatusBadge","ConfirmModal","name","components","data","selectedCategory","confirmDeleteOpen","designToDelete","computed","filteredDesigns","allDesigns","filter","d","category","methods","promptDelete","design","confirmDelete","$store","dispatch","id"],"sources":["C:\\Users\\jayde\\Desktop\\frameVue\\src\\views\\admin\\Designs.vue"],"sourcesContent":["<template>\n  <div class=\"space-y-6\">\n    <!-- Header Bar -->\n    <div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white rounded-2xl border border-cream-200 p-5 shadow-soft\">\n      <div>\n        <h2 class=\"text-xl font-serif font-bold text-charcoal-900\">\n          Design Templates ({{ filteredDesigns.length }})\n        </h2>\n        <p class=\"text-xs text-charcoal-800/65\">\n          Manage occasion designs across Wedding, Romantic, Birthday, Anniversary, Family, Kids, Festival, Minimal &amp; Classic\n        </p>\n      </div>\n\n      <div class=\"flex flex-wrap items-center gap-3\">\n        <select\n          v-model=\"selectedCategory\"\n          class=\"px-3.5 py-2 rounded-xl bg-cream-50 border border-cream-300 text-xs font-semibold text-charcoal-900 focus:outline-none focus:border-gold-600\"\n        >\n          <option value=\"All\">All Categories</option>\n          <option v-for=\"cat in categories\" :key=\"cat\" :value=\"cat\">{{ cat }}</option>\n        </select>\n\n        <router-link\n          to=\"/admin/designs/add\"\n          class=\"inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-charcoal-900 hover:bg-gold-600 text-white text-xs font-semibold transition-colors shadow-sm\"\n        >\n          <Plus class=\"w-4 h-4\" />\n          <span>Add New Design</span>\n        </router-link>\n      </div>\n    </div>\n\n    <!-- Designs Table -->\n    <div class=\"bg-white rounded-2xl border border-cream-200 shadow-soft overflow-hidden\">\n      <div class=\"overflow-x-auto\">\n        <table class=\"w-full text-left border-collapse\">\n          <thead>\n            <tr class=\"border-b border-cream-200 bg-cream-50/80 text-[11px] font-semibold uppercase tracking-wider text-charcoal-800/70\">\n              <th class=\"py-3.5 px-4\">Preview</th>\n              <th class=\"py-3.5 px-4\">Name</th>\n              <th class=\"py-3.5 px-4\">Category</th>\n              <th class=\"py-3.5 px-4\">Description</th>\n              <th class=\"py-3.5 px-4\">Status</th>\n              <th class=\"py-3.5 px-4 text-right\">Actions</th>\n            </tr>\n          </thead>\n          <tbody class=\"divide-y divide-cream-200 text-sm\">\n            <tr\n              v-for=\"design in filteredDesigns\"\n              :key=\"design.id\"\n              class=\"hover:bg-cream-50/60 transition-colors\"\n            >\n              <td class=\"py-3.5 px-4\">\n                <img\n                  :src=\"design.image\"\n                  :alt=\"design.name\"\n                  class=\"w-14 h-14 rounded-xl object-cover border border-cream-300\"\n                />\n              </td>\n              <td class=\"py-3.5 px-4 font-serif font-semibold text-charcoal-900 whitespace-nowrap\">\n                {{ design.name }}\n              </td>\n              <td class=\"py-3.5 px-4 whitespace-nowrap\">\n                <span class=\"px-2.5 py-1 rounded-full text-xs font-medium bg-gold-50 text-gold-800 border border-gold-200\">\n                  {{ design.category }}\n                </span>\n              </td>\n              <td class=\"py-3.5 px-4 text-xs text-charcoal-800/75 max-w-md\">\n                {{ design.description }}\n              </td>\n              <td class=\"py-3.5 px-4 whitespace-nowrap\">\n                <StatusBadge :status=\"design.status || 'active'\" />\n              </td>\n              <td class=\"py-3.5 px-4 text-right whitespace-nowrap\">\n                <div class=\"inline-flex items-center gap-1.5\">\n                  <router-link\n                    :to=\"`/admin/designs/add?edit=${design.id}`\"\n                    class=\"p-2 rounded-xl bg-cream-100 hover:bg-gold-100 text-charcoal-800 hover:text-gold-800 transition-colors\"\n                    title=\"Edit Design\"\n                  >\n                    <Pencil class=\"w-4 h-4\" />\n                  </router-link>\n                  <button\n                    type=\"button\"\n                    class=\"p-2 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-600 transition-colors\"\n                    title=\"Delete Design\"\n                    @click=\"promptDelete(design)\"\n                  >\n                    <Trash2 class=\"w-4 h-4\" />\n                  </button>\n                </div>\n              </td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n    </div>\n\n    <!-- Confirm Delete Modal -->\n    <ConfirmModal\n      v-model=\"confirmDeleteOpen\"\n      title=\"Delete Design Template\"\n      :message=\"`Are you sure you want to delete '${designToDelete?.name}'?`\"\n      confirm-text=\"Delete Design\"\n      @confirm=\"confirmDelete\"\n    />\n  </div>\n</template>\n\n<script>\nimport { mapGetters } from 'vuex'\nimport { Plus, Pencil, Trash2 } from 'lucide-vue-next'\nimport StatusBadge from '@/components/common/StatusBadge.vue'\nimport ConfirmModal from '@/components/common/ConfirmModal.vue'\n\nexport default {\n  name: 'AdminDesignsView',\n  components: {\n    Plus,\n    Pencil,\n    Trash2,\n    StatusBadge,\n    ConfirmModal\n  },\n  data() {\n    return {\n      selectedCategory: 'All',\n      confirmDeleteOpen: false,\n      designToDelete: null\n    }\n  },\n  computed: {\n    ...mapGetters('designs', ['allDesigns', 'categories']),\n    filteredDesigns() {\n      if (this.selectedCategory === 'All') return this.allDesigns\n      return this.allDesigns.filter(d => d.category === this.selectedCategory)\n    }\n  },\n  methods: {\n    promptDelete(design) {\n      this.designToDelete = design\n      this.confirmDeleteOpen = true\n    },\n    async confirmDelete() {\n      if (this.designToDelete) {\n        await this.$store.dispatch('designs/deleteDesign', this.designToDelete.id)\n        this.designToDelete = null\n      }\n    }\n  }\n}\n</script>\n"],"mappings":";;AA8GA,SAASA,UAAS,QAAS,MAAK;AAChC,SAASC,IAAI,EAAEC,MAAM,EAAEC,MAAK,QAAS,iBAAgB;AACrD,OAAOC,WAAU,MAAO,qCAAoC;AAC5D,OAAOC,YAAW,MAAO,sCAAqC;AAE9D,eAAe;EACbC,IAAI,EAAE,kBAAkB;EACxBC,UAAU,EAAE;IACVN,IAAI;IACJC,MAAM;IACNC,MAAM;IACNC,WAAW;IACXC;EACF,CAAC;EACDG,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,gBAAgB,EAAE,KAAK;MACvBC,iBAAiB,EAAE,KAAK;MACxBC,cAAc,EAAE;IAClB;EACF,CAAC;EACDC,QAAQ,EAAE;IACR,GAAGZ,UAAU,CAAC,SAAS,EAAE,CAAC,YAAY,EAAE,YAAY,CAAC,CAAC;IACtDa,eAAeA,CAAA,EAAG;MAChB,IAAI,IAAI,CAACJ,gBAAe,KAAM,KAAK,EAAE,OAAO,IAAI,CAACK,UAAS;MAC1D,OAAO,IAAI,CAACA,UAAU,CAACC,MAAM,CAACC,CAAA,IAAKA,CAAC,CAACC,QAAO,KAAM,IAAI,CAACR,gBAAgB;IACzE;EACF,CAAC;EACDS,OAAO,EAAE;IACPC,YAAYA,CAACC,MAAM,EAAE;MACnB,IAAI,CAACT,cAAa,GAAIS,MAAK;MAC3B,IAAI,CAACV,iBAAgB,GAAI,IAAG;IAC9B,CAAC;IACD,MAAMW,aAAaA,CAAA,EAAG;MACpB,IAAI,IAAI,CAACV,cAAc,EAAE;QACvB,MAAM,IAAI,CAACW,MAAM,CAACC,QAAQ,CAAC,sBAAsB,EAAE,IAAI,CAACZ,cAAc,CAACa,EAAE;QACzE,IAAI,CAACb,cAAa,GAAI,IAAG;MAC3B;IACF;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}