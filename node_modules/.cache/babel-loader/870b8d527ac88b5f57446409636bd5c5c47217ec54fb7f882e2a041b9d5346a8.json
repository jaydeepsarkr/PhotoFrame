{"ast":null,"code":"import { mapGetters } from 'vuex';\nimport { ShoppingBag, Clock, Hammer, CheckCircle2, Frame, Palette, ArrowRight } from 'lucide-vue-next';\nimport StatsCard from '@/components/admin/StatsCard.vue';\nimport OrderTable from '@/components/admin/OrderTable.vue';\nimport { formatCurrency } from '@/utils/formatters';\nexport default {\n  name: 'AdminDashboardView',\n  components: {\n    ShoppingBag,\n    Clock,\n    Hammer,\n    CheckCircle2,\n    Frame,\n    Palette,\n    ArrowRight,\n    StatsCard,\n    OrderTable\n  },\n  computed: {\n    ...mapGetters('orders', ['allOrders', 'orderStats']),\n    ...mapGetters('frames', ['allFrames']),\n    ...mapGetters('designs', ['allDesigns']),\n    recentOrders() {\n      return this.allOrders.slice(0, 6);\n    }\n  },\n  methods: {\n    formatCurrency,\n    resetDemoData() {\n      localStorage.clear();\n      window.location.reload();\n    }\n  }\n};","map":{"version":3,"names":["mapGetters","ShoppingBag","Clock","Hammer","CheckCircle2","Frame","Palette","ArrowRight","StatsCard","OrderTable","formatCurrency","name","components","computed","recentOrders","allOrders","slice","methods","resetDemoData","localStorage","clear","window","location","reload"],"sources":["C:\\Users\\jayde\\Desktop\\frameVue\\src\\views\\admin\\Dashboard.vue"],"sourcesContent":["<template>\n  <div class=\"space-y-8\">\n    <!-- KPI Statistics Grid (6 Cards) -->\n    <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-4\">\n      <StatsCard\n        label=\"Total Orders\"\n        :value=\"orderStats.total\"\n        subtext=\"All-time studio orders\"\n        tone=\"gold\"\n      >\n        <template #icon>\n          <ShoppingBag class=\"w-5 h-5\" />\n        </template>\n      </StatsCard>\n\n      <StatsCard\n        label=\"Pending Orders\"\n        :value=\"orderStats.pending\"\n        subtext=\"New & Confirmed\"\n        tone=\"amber\"\n      >\n        <template #icon>\n          <Clock class=\"w-5 h-5\" />\n        </template>\n      </StatsCard>\n\n      <StatsCard\n        label=\"Processing\"\n        :value=\"orderStats.processing\"\n        subtext=\"In Workshop / Shipped\"\n        tone=\"purple\"\n      >\n        <template #icon>\n          <Hammer class=\"w-5 h-5\" />\n        </template>\n      </StatsCard>\n\n      <StatsCard\n        label=\"Completed\"\n        :value=\"orderStats.completed\"\n        subtext=\"Successfully delivered\"\n        tone=\"emerald\"\n      >\n        <template #icon>\n          <CheckCircle2 class=\"w-5 h-5\" />\n        </template>\n      </StatsCard>\n\n      <StatsCard\n        label=\"Total Frames\"\n        :value=\"allFrames.length\"\n        subtext=\"Active mouldings\"\n        tone=\"blue\"\n      >\n        <template #icon>\n          <Frame class=\"w-5 h-5\" />\n        </template>\n      </StatsCard>\n\n      <StatsCard\n        label=\"Total Designs\"\n        :value=\"allDesigns.length\"\n        subtext=\"9 Occasion categories\"\n        tone=\"gold\"\n      >\n        <template #icon>\n          <Palette class=\"w-5 h-5\" />\n        </template>\n      </StatsCard>\n    </div>\n\n    <!-- Optional Studio Settings Panel when clicking Settings in Sidebar -->\n    <div\n      v-if=\"$route.query.section === 'settings'\"\n      class=\"bg-white rounded-2xl border border-gold-300 p-6 shadow-soft space-y-4\"\n    >\n      <div class=\"flex items-center justify-between border-b border-cream-200 pb-3\">\n        <div>\n          <h2 class=\"text-lg font-serif font-bold text-charcoal-900\">\n            Studio &amp; Prototype Settings\n          </h2>\n          <p class=\"text-xs text-charcoal-800/65\">\n            Manage local prototype persistence (`localStorage`) and studio defaults.\n          </p>\n        </div>\n        <button\n          type=\"button\"\n          class=\"px-4 py-2 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 text-xs font-semibold transition-colors\"\n          @click=\"resetDemoData\"\n        >\n          Reset All Demo Data to Defaults\n        </button>\n      </div>\n      <div class=\"grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs\">\n        <div class=\"p-3.5 rounded-xl bg-cream-50 border border-cream-200\">\n          <span class=\"text-charcoal-800/60 block\">Store Currency</span>\n          <strong class=\"text-charcoal-900 text-sm\">INR (₹)</strong>\n        </div>\n        <div class=\"p-3.5 rounded-xl bg-cream-50 border border-cream-200\">\n          <span class=\"text-charcoal-800/60 block\">Standard Delivery Fee</span>\n          <strong class=\"text-charcoal-900 text-sm\">₹100 Pan-India</strong>\n        </div>\n        <div class=\"p-3.5 rounded-xl bg-cream-50 border border-cream-200\">\n          <span class=\"text-charcoal-800/60 block\">Backend API Mode</span>\n          <strong class=\"text-emerald-700 text-sm\">Mock Service Layer Active</strong>\n        </div>\n      </div>\n    </div>\n\n    <!-- Quick Management Cards -->\n    <div class=\"grid grid-cols-1 md:grid-cols-3 gap-5\">\n      <div class=\"bg-white rounded-2xl border border-cream-200 p-5 shadow-soft flex items-center justify-between\">\n        <div>\n          <h3 class=\"font-serif font-semibold text-charcoal-900\">Frame Mouldings</h3>\n          <p class=\"text-xs text-charcoal-800/65 mt-0.5\">Add, edit, or update pricing &amp; sizes</p>\n        </div>\n        <router-link\n          to=\"/admin/frames/add\"\n          class=\"px-4 py-2 rounded-xl bg-charcoal-900 hover:bg-gold-600 text-white text-xs font-semibold transition-colors\"\n        >\n          + Add Frame\n        </router-link>\n      </div>\n\n      <div class=\"bg-white rounded-2xl border border-cream-200 p-5 shadow-soft flex items-center justify-between\">\n        <div>\n          <h3 class=\"font-serif font-semibold text-charcoal-900\">Design Templates</h3>\n          <p class=\"text-xs text-charcoal-800/65 mt-0.5\">Manage occasion borders &amp; themes</p>\n        </div>\n        <router-link\n          to=\"/admin/designs/add\"\n          class=\"px-4 py-2 rounded-xl bg-charcoal-900 hover:bg-gold-600 text-white text-xs font-semibold transition-colors\"\n        >\n          + Add Design\n        </router-link>\n      </div>\n\n      <div class=\"bg-white rounded-2xl border border-cream-200 p-5 shadow-soft flex items-center justify-between\">\n        <div>\n          <h3 class=\"font-serif font-semibold text-charcoal-900\">Studio Revenue</h3>\n          <p class=\"text-xs text-charcoal-800/65 mt-0.5\">Active non-cancelled order value</p>\n        </div>\n        <span class=\"text-xl font-serif font-bold text-gold-700\">\n          {{ formatCurrency(orderStats.revenue) }}\n        </span>\n      </div>\n    </div>\n\n    <!-- Recent Orders Section -->\n    <div class=\"space-y-4\">\n      <div class=\"flex items-center justify-between\">\n        <div>\n          <h2 class=\"text-xl font-serif font-bold text-charcoal-900\">\n            Recent Orders\n          </h2>\n          <p class=\"text-xs text-charcoal-800/65\">\n            Latest custom framing orders placed by customers\n          </p>\n        </div>\n        <router-link\n          to=\"/admin/orders\"\n          class=\"inline-flex items-center gap-1.5 text-xs font-semibold text-charcoal-900 hover:text-gold-600\"\n        >\n          <span>View All Orders</span>\n          <ArrowRight class=\"w-3.5 h-3.5\" />\n        </router-link>\n      </div>\n\n      <OrderTable :orders=\"recentOrders\" />\n    </div>\n  </div>\n</template>\n\n<script>\nimport { mapGetters } from 'vuex'\nimport {\n  ShoppingBag,\n  Clock,\n  Hammer,\n  CheckCircle2,\n  Frame,\n  Palette,\n  ArrowRight\n} from 'lucide-vue-next'\nimport StatsCard from '@/components/admin/StatsCard.vue'\nimport OrderTable from '@/components/admin/OrderTable.vue'\nimport { formatCurrency } from '@/utils/formatters'\n\nexport default {\n  name: 'AdminDashboardView',\n  components: {\n    ShoppingBag,\n    Clock,\n    Hammer,\n    CheckCircle2,\n    Frame,\n    Palette,\n    ArrowRight,\n    StatsCard,\n    OrderTable\n  },\n  computed: {\n    ...mapGetters('orders', ['allOrders', 'orderStats']),\n    ...mapGetters('frames', ['allFrames']),\n    ...mapGetters('designs', ['allDesigns']),\n    recentOrders() {\n      return this.allOrders.slice(0, 6)\n    }\n  },\n  methods: {\n    formatCurrency,\n    resetDemoData() {\n      localStorage.clear()\n      window.location.reload()\n    }\n  }\n}\n</script>\n"],"mappings":"AA8KA,SAASA,UAAS,QAAS,MAAK;AAChC,SACEC,WAAW,EACXC,KAAK,EACLC,MAAM,EACNC,YAAY,EACZC,KAAK,EACLC,OAAO,EACPC,UAAS,QACJ,iBAAgB;AACvB,OAAOC,SAAQ,MAAO,kCAAiC;AACvD,OAAOC,UAAS,MAAO,mCAAkC;AACzD,SAASC,cAAa,QAAS,oBAAmB;AAElD,eAAe;EACbC,IAAI,EAAE,oBAAoB;EAC1BC,UAAU,EAAE;IACVX,WAAW;IACXC,KAAK;IACLC,MAAM;IACNC,YAAY;IACZC,KAAK;IACLC,OAAO;IACPC,UAAU;IACVC,SAAS;IACTC;EACF,CAAC;EACDI,QAAQ,EAAE;IACR,GAAGb,UAAU,CAAC,QAAQ,EAAE,CAAC,WAAW,EAAE,YAAY,CAAC,CAAC;IACpD,GAAGA,UAAU,CAAC,QAAQ,EAAE,CAAC,WAAW,CAAC,CAAC;IACtC,GAAGA,UAAU,CAAC,SAAS,EAAE,CAAC,YAAY,CAAC,CAAC;IACxCc,YAAYA,CAAA,EAAG;MACb,OAAO,IAAI,CAACC,SAAS,CAACC,KAAK,CAAC,CAAC,EAAE,CAAC;IAClC;EACF,CAAC;EACDC,OAAO,EAAE;IACPP,cAAc;IACdQ,aAAaA,CAAA,EAAG;MACdC,YAAY,CAACC,KAAK,CAAC;MACnBC,MAAM,CAACC,QAAQ,CAACC,MAAM,CAAC;IACzB;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}