{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { Eye, ArrowRight } from 'lucide-vue-next';\nimport { formatCurrency, formatSizeLabel } from '@/utils/formatters';\nexport default {\n  name: 'FrameCard',\n  components: {\n    Eye,\n    ArrowRight\n  },\n  props: {\n    frame: {\n      type: Object,\n      required: true\n    }\n  },\n  methods: {\n    formatCurrency,\n    formatSizeLabel,\n    onCustomize() {\n      this.$store.dispatch('customization/setSelectedFrame', this.frame);\n      this.$router.push(`/customize/${this.frame.id}`);\n    }\n  }\n};","map":{"version":3,"names":["Eye","ArrowRight","formatCurrency","formatSizeLabel","name","components","props","frame","type","Object","required","methods","onCustomize","$store","dispatch","$router","push","id"],"sources":["C:\\Users\\jayde\\Desktop\\frameVue\\src\\components\\customer\\FrameCard.vue"],"sourcesContent":["<template>\n  <article\n    class=\"group bg-white rounded-2xl border border-cream-200 overflow-hidden shadow-soft hover:shadow-elevated hover:-translate-y-0.5 transition-all duration-300 flex flex-col\"\n  >\n    <!-- Image Container -->\n    <router-link :to=\"`/frames/${frame.id}`\" class=\"relative aspect-4/3 overflow-hidden bg-cream-100 block\">\n      <img\n        :src=\"frame.image\"\n        :alt=\"frame.name\"\n        class=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-500\"\n        loading=\"lazy\"\n      />\n      <div class=\"absolute top-3 left-3 flex flex-wrap gap-1.5\">\n        <span class=\"px-2.5 py-1 rounded-full text-[11px] font-semibold tracking-wide bg-white/95 text-charcoal-900 backdrop-blur-xs shadow-2xs\">\n          {{ frame.material }}\n        </span>\n        <span\n          v-if=\"frame.style\"\n          class=\"px-2.5 py-1 rounded-full text-[11px] font-medium bg-charcoal-900/85 text-cream-50 backdrop-blur-xs\"\n        >\n          {{ frame.style }}\n        </span>\n      </div>\n      <div\n        v-if=\"frame.isNew\"\n        class=\"absolute top-3 right-3 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-gold-600 text-white shadow-2xs\"\n      >\n        New\n      </div>\n    </router-link>\n\n    <!-- Content -->\n    <div class=\"p-5 flex-1 flex flex-col justify-between space-y-4\">\n      <div>\n        <div class=\"flex items-start justify-between gap-2 mb-1.5\">\n          <router-link\n            :to=\"`/frames/${frame.id}`\"\n            class=\"text-lg font-serif font-semibold text-charcoal-900 group-hover:text-gold-700 transition-colors line-clamp-1\"\n          >\n            {{ frame.name }}\n          </router-link>\n        </div>\n\n        <p class=\"text-xs text-charcoal-800/70 line-clamp-2 leading-relaxed mb-3.5\">\n          {{ frame.description }}\n        </p>\n\n        <!-- Available Sizes -->\n        <div class=\"flex flex-wrap items-center gap-1.5\">\n          <span\n            v-for=\"size in frame.sizes\"\n            :key=\"size\"\n            class=\"px-2 py-0.5 rounded-md text-[11px] font-medium bg-cream-100 text-charcoal-800 border border-cream-300/70\"\n          >\n            {{ formatSizeLabel(size) }}\n          </span>\n        </div>\n      </div>\n\n      <!-- Price & Actions -->\n      <div class=\"pt-3.5 border-t border-cream-200 flex items-center justify-between gap-3\">\n        <div>\n          <span class=\"block text-[10px] uppercase tracking-wider text-charcoal-800/50 font-medium\">\n            Starting at\n          </span>\n          <div class=\"flex items-baseline gap-1.5\">\n            <span class=\"text-lg font-bold text-charcoal-900\">\n              {{ formatCurrency(frame.discountPrice || frame.price) }}\n            </span>\n            <span\n              v-if=\"frame.discountPrice && frame.discountPrice < frame.price\"\n              class=\"text-xs text-charcoal-800/45 line-through\"\n            >\n              {{ formatCurrency(frame.price) }}\n            </span>\n          </div>\n        </div>\n\n        <div class=\"flex items-center gap-2\">\n          <router-link\n            :to=\"`/frames/${frame.id}`\"\n            class=\"p-2.5 rounded-xl border border-cream-300 text-charcoal-800 hover:bg-cream-100 transition-colors\"\n            title=\"View Frame Details\"\n          >\n            <Eye class=\"w-4 h-4\" />\n          </router-link>\n          <button\n            type=\"button\"\n            class=\"inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-charcoal-900 hover:bg-gold-600 text-white text-xs font-semibold transition-colors shadow-2xs\"\n            @click=\"onCustomize\"\n          >\n            <span>Customize Now</span>\n            <ArrowRight class=\"w-3.5 h-3.5\" />\n          </button>\n        </div>\n      </div>\n    </div>\n  </article>\n</template>\n\n<script>\nimport { Eye, ArrowRight } from 'lucide-vue-next'\nimport { formatCurrency, formatSizeLabel } from '@/utils/formatters'\n\nexport default {\n  name: 'FrameCard',\n  components: {\n    Eye,\n    ArrowRight\n  },\n  props: {\n    frame: {\n      type: Object,\n      required: true\n    }\n  },\n  methods: {\n    formatCurrency,\n    formatSizeLabel,\n    onCustomize() {\n      this.$store.dispatch('customization/setSelectedFrame', this.frame)\n      this.$router.push(`/customize/${this.frame.id}`)\n    }\n  }\n}\n</script>\n"],"mappings":";AAqGA,SAASA,GAAG,EAAEC,UAAS,QAAS,iBAAgB;AAChD,SAASC,cAAc,EAAEC,eAAc,QAAS,oBAAmB;AAEnE,eAAe;EACbC,IAAI,EAAE,WAAW;EACjBC,UAAU,EAAE;IACVL,GAAG;IACHC;EACF,CAAC;EACDK,KAAK,EAAE;IACLC,KAAK,EAAE;MACLC,IAAI,EAAEC,MAAM;MACZC,QAAQ,EAAE;IACZ;EACF,CAAC;EACDC,OAAO,EAAE;IACPT,cAAc;IACdC,eAAe;IACfS,WAAWA,CAAA,EAAG;MACZ,IAAI,CAACC,MAAM,CAACC,QAAQ,CAAC,gCAAgC,EAAE,IAAI,CAACP,KAAK;MACjE,IAAI,CAACQ,OAAO,CAACC,IAAI,CAAC,cAAc,IAAI,CAACT,KAAK,CAACU,EAAE,EAAE;IACjD;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}