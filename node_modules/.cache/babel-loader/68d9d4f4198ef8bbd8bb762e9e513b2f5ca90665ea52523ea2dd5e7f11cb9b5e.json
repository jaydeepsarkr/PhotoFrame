{"ast":null,"code":"import { TrendingUp } from 'lucide-vue-next';\nexport default {\n  name: 'StatsCard',\n  components: {\n    TrendingUp\n  },\n  props: {\n    label: {\n      type: String,\n      required: true\n    },\n    value: {\n      type: [String, Number],\n      required: true\n    },\n    subtext: {\n      type: String,\n      default: ''\n    },\n    tone: {\n      type: String,\n      default: 'gold'\n    }\n  },\n  computed: {\n    accentClass() {\n      switch (this.tone) {\n        case 'amber':\n          return 'bg-amber-50 text-amber-700 border-amber-200';\n        case 'purple':\n          return 'bg-purple-50 text-purple-700 border-purple-200';\n        case 'emerald':\n          return 'bg-emerald-50 text-emerald-700 border-emerald-200';\n        case 'blue':\n          return 'bg-blue-50 text-blue-700 border-blue-200';\n        default:\n          return 'bg-gold-50 text-gold-700 border-gold-200';\n      }\n    }\n  }\n};","map":{"version":3,"names":["TrendingUp","name","components","props","label","type","String","required","value","Number","subtext","default","tone","computed","accentClass"],"sources":["C:\\Users\\jayde\\Desktop\\frameVue\\src\\components\\admin\\StatsCard.vue"],"sourcesContent":["<template>\n  <div class=\"bg-white rounded-2xl border border-cream-200 p-5 shadow-soft hover:shadow-md transition-shadow flex items-start justify-between gap-4\">\n    <div>\n      <p class=\"text-xs font-semibold uppercase tracking-wider text-charcoal-800/60\">\n        {{ label }}\n      </p>\n      <p class=\"text-2xl sm:text-3xl font-serif font-bold text-charcoal-900 mt-1.5\">\n        {{ value }}\n      </p>\n      <p v-if=\"subtext\" class=\"text-xs text-charcoal-800/60 mt-1\">\n        {{ subtext }}\n      </p>\n    </div>\n    <div\n      :class=\"[\n        'w-11 h-11 rounded-xl flex items-center justify-center shrink-0 border',\n        accentClass\n      ]\"\n    >\n      <slot name=\"icon\">\n        <TrendingUp class=\"w-5 h-5\" />\n      </slot>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { TrendingUp } from 'lucide-vue-next'\n\nexport default {\n  name: 'StatsCard',\n  components: { TrendingUp },\n  props: {\n    label: {\n      type: String,\n      required: true\n    },\n    value: {\n      type: [String, Number],\n      required: true\n    },\n    subtext: {\n      type: String,\n      default: ''\n    },\n    tone: {\n      type: String,\n      default: 'gold'\n    }\n  },\n  computed: {\n    accentClass() {\n      switch (this.tone) {\n        case 'amber':\n          return 'bg-amber-50 text-amber-700 border-amber-200'\n        case 'purple':\n          return 'bg-purple-50 text-purple-700 border-purple-200'\n        case 'emerald':\n          return 'bg-emerald-50 text-emerald-700 border-emerald-200'\n        case 'blue':\n          return 'bg-blue-50 text-blue-700 border-blue-200'\n        default:\n          return 'bg-gold-50 text-gold-700 border-gold-200'\n      }\n    }\n  }\n}\n</script>\n"],"mappings":"AA2BA,SAASA,UAAS,QAAS,iBAAgB;AAE3C,eAAe;EACbC,IAAI,EAAE,WAAW;EACjBC,UAAU,EAAE;IAAEF;EAAW,CAAC;EAC1BG,KAAK,EAAE;IACLC,KAAK,EAAE;MACLC,IAAI,EAAEC,MAAM;MACZC,QAAQ,EAAE;IACZ,CAAC;IACDC,KAAK,EAAE;MACLH,IAAI,EAAE,CAACC,MAAM,EAAEG,MAAM,CAAC;MACtBF,QAAQ,EAAE;IACZ,CAAC;IACDG,OAAO,EAAE;MACPL,IAAI,EAAEC,MAAM;MACZK,OAAO,EAAE;IACX,CAAC;IACDC,IAAI,EAAE;MACJP,IAAI,EAAEC,MAAM;MACZK,OAAO,EAAE;IACX;EACF,CAAC;EACDE,QAAQ,EAAE;IACRC,WAAWA,CAAA,EAAG;MACZ,QAAQ,IAAI,CAACF,IAAI;QACf,KAAK,OAAO;UACV,OAAO,6CAA4C;QACrD,KAAK,QAAQ;UACX,OAAO,gDAA+C;QACxD,KAAK,SAAS;UACZ,OAAO,mDAAkD;QAC3D,KAAK,MAAM;UACT,OAAO,0CAAyC;QAClD;UACE,OAAO,0CAAyC;MACpD;IACF;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}